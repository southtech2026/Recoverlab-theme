<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}

    {%- comment -%} ── Recoverlab SEO: Open Graph + Twitter Card + JSON-LD ── {%- endcomment -%}

    {%- liquid
      assign seo_title = page_title | default: shop.name
      assign seo_desc  = page_description | default: 'Köp premium recovery-produkter, massagepistol, blåljusglasögon och träningsverktyg för optimal återhämtning. Vetenskapligt beprövat, svenskt fokus.'
      if template.name == 'product'
        assign seo_image = product.featured_image | image_url: width: 1200
        assign seo_price = product.price | money_without_currency
        assign seo_avail = 'https://schema.org/InStock'
        unless product.available
          assign seo_avail = 'https://schema.org/OutOfStock'
        endunless
      elsif template.name == 'collection'
        assign seo_image = collection.image | image_url: width: 1200
      else
        assign seo_image = settings.share_image | image_url: width: 1200
      endif
    -%}

    {%- comment -%} Open Graph {%- endcomment -%}
    <meta property="og:site_name"   content="{{ shop.name | escape }}">
    <meta property="og:url"         content="{{ canonical_url }}">
    <meta property="og:type"        content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:title"       content="{{ seo_title | escape }}">
    <meta property="og:description" content="{{ seo_desc | escape }}">
    {%- if seo_image != blank -%}
      <meta property="og:image"       content="https:{{ seo_image }}">
      <meta property="og:image:width" content="1200">
    {%- endif -%}
    {%- if template.name == 'product' -%}
      <meta property="og:price:amount"   content="{{ seo_price }}">
      <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
    {%- endif -%}

    {%- comment -%} Twitter Card {%- endcomment -%}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{{ seo_title | escape }}">
    <meta name="twitter:description" content="{{ seo_desc | escape }}">
    {%- if seo_image != blank -%}
      <meta name="twitter:image" content="https:{{ seo_image }}">
    {%- endif -%}

    {%- comment -%} Organisation JSON-LD {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Recoverlab",
      "url": "https://recoverlab.se",
      "logo": "{{ settings.logo | image_url: width: 400 | prepend: 'https:' }}",
      "description": "Premium recovery-produkter för svenska idrottare — vetenskapligt beprövade.",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "kontakt@recoverlabs.se",
        "contactType": "customer service",
        "availableLanguage": "Swedish"
      },
      "address": { "@type": "PostalAddress", "addressCountry": "SE" },
      "sameAs": [
        "https://www.instagram.com/recoverlab.se",
        "https://www.facebook.com/recoverlab.se"
      ]
    }
    </script>

    {%- comment -%} Product JSON-LD {%- endcomment -%}
    {%- if template.name == 'product' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 300 | json }},
      "image": "https:{{ product.featured_image | image_url: width: 1200 }}",
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      "brand": { "@type": "Brand", "name": "Recoverlab" },
      "offers": {
        "@type": "Offer",
        "url": "{{ canonical_url }}",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": "{{ product.price | money_without_currency | remove: ' ' }}",
        "availability": {{ seo_avail | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": "Recoverlab" }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "70",
        "bestRating": "5",
        "worstRating": "1"
      }
    }
    </script>
    {%- endif -%}

    {%- comment -%} Breadcrumb JSON-LD {%- endcomment -%}
    {%- if template.name == 'product' or template.name == 'collection' or template.name == 'page' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Hem",
          "item": "{{ shop.url }}"
        }
        {%- if template.name == 'collection' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        }
        {%- elsif template.name == 'product' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": "Produkter",
          "item": "{{ shop.url }}/collections/all"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ canonical_url }}"
        }
        {%- elsif template.name == 'page' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": "{{ canonical_url }}"
        }
        {%- endif -%}
      ]
    }
    </script>
    {%- endif -%}

    {%- comment -%} WebSite schema with Sitelinks Searchbox {%- endcomment -%}
    {%- if template.name == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Recoverlab",
      "url": "https://recoverlab.se",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    {%- endif -%}

    {%- render 'pb-fonts' -%}
    {%- comment -%} Preload critical CSS assets for LCP performance {%- endcomment -%}
    <link rel="preload" href="{{ 'premium-brand.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>{{ 'premium-brand.css' | asset_url | stylesheet_tag }}</noscript>
    {{ 'pb-wellness-overrides.css' | asset_url | stylesheet_tag }}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <style id="rl-cart-drawer-critical">
      /* Black header background */
      #cart-drawer-header,
      .cart-drawer__header {
        background: #000000 !important;
        background-color: #000000 !important;
      }
      /* Heading div: transparent bg so it inherits black from header, white text */
      #cart-drawer-heading,
      .cart-drawer__heading {
        background: transparent !important;
        background-color: transparent !important;
        color: #ffffff !important;
      }
      /* VARUKORG text element */
      #rl-varukorg {
        background: transparent !important;
        background-color: transparent !important;
        color: #ffffff !important;
        font-family: Montserrat, sans-serif !important;
        font-weight: 800 !important;
        font-size: 15px !important;
        letter-spacing: .06em !important;
        text-transform: uppercase !important;
        opacity: 1 !important;
        visibility: visible !important;
        display: inline-block !important;
      }
    </style>

    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    {%- render 'pb-rotating-announcement' -%}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
