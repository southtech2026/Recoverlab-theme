{% comment %}
  Trustpilot footer badge
  Uses official TrustBox mini widget if business_unit_id is provided via section settings,
  otherwise shows styled static badge.

  Usage: {% render 'trustpilot-badge', business_unit_id: 'YOUR_ID' %}
{% endcomment %}

{%- assign tp_id = business_unit_id -%}

{%- if tp_id != blank -%}

  <div style="padding: 4px 0;">
    <div
      class="trustpilot-widget"
      data-locale="sv-SE"
      data-template-id="5406e65db0d04a09e042d5fc"
      data-businessunit-id="{{ tp_id }}"
      data-style-height="28px"
      data-style-width="100%"
      data-theme="dark"
    >
      <a href="https://www.trustpilot.com/review/recoverlab.se" target="_blank" rel="noopener" style="color:#00b67a;">★ Trustpilot</a>
    </div>
  </div>
  <script src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>

{%- else -%}

  <a
    href="https://www.trustpilot.com/review/recoverlab.se"
    target="_blank"
    rel="noopener"
    class="tp-badge"
    aria-label="Se Recoverlab på Trustpilot — 4.9 av 5"
  >
    <div class="tp-badge__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- endfor -%}
    </div>
    <div class="tp-badge__text">
      <span class="tp-badge__score">4.9 / 5</span>
      <span class="tp-badge__label">Baserat på 1 247+ omdömen</span>
    </div>
    <span class="tp-badge__logo">★ Trustpilot</span>
  </a>

  <style>
    .tp-badge { display:inline-flex; align-items:center; gap:12px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); padding:12px 20px; text-decoration:none; transition:background 200ms; flex-wrap:wrap; }
    .tp-badge:hover { background:rgba(255,255,255,0.1); }
    .tp-badge__stars { display:flex; gap:2px; }
    .tp-badge__stars svg { width:15px; height:15px; fill:#00b67a; }
    .tp-badge__text { display:flex; flex-direction:column; gap:1px; }
    .tp-badge__score { font-family:'Inter',sans-serif; font-size:13px; font-weight:700; color:#ffffff !important; }
    .tp-badge__label { font-family:'Inter',sans-serif; font-size:11px; color:rgba(255,255,255,0.55) !important; }
    .tp-badge__logo  { font-family:'Inter',sans-serif; font-size:13px; font-weight:700; color:#00b67a !important; }
  </style>

{%- endif -%}
