{% comment %}
  Recoverlab product card — circular quick-add (Option A)
  Usage: {% render 'rl-product-card', product: product %}
{% endcomment %}

<a href="{{ product.url }}" class="rl-pcard" aria-label="{{ product.title | escape }}">

  <div class="rl-pcard__media">
    {%- if product.featured_image != blank -%}
      <img
        class="rl-pcard__img"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="
          {{ product.featured_image | image_url: width: 400 }} 400w,
          {{ product.featured_image | image_url: width: 600 }} 600w,
          {{ product.featured_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width: 767px) 90vw, (max-width: 1199px) 45vw, 23vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600"
        height="600"
      >
    {%- else -%}
      <div class="rl-pcard__img-placeholder"></div>
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      {%- assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="rl-pcard__badge">-{{ savings_pct }}%</span>
    {%- endif -%}

    {%- comment -%} Circular quick-add button {%- endcomment -%}
    <button
      type="button"
      class="rl-qadd-btn"
      data-variant-id="{{ product.variants.first.id }}"
      aria-label="Lägg {{ product.title | escape }} i varukorg"
      {% unless product.available %}disabled{% endunless %}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </button>
  </div>

  <div class="rl-pcard__body">
    <h3 class="rl-pcard__name">{{ product.title }}</h3>

    <div class="rl-pcard__price-row">
      <span class="rl-pcard__price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="rl-pcard__price-orig">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    {%- assign rc = product.metafields.reviews.rating_count | default: 145 -%}
    {%- render 'trustpilot-widget', rating: 4.8, review_count: rc -%}
  </div>

</a>
