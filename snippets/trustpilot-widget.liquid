{% comment %}
  Trustpilot mini-widget — use on product cards
  Parameters:
    rating       — number 1–5 (default 4.8)
    review_count — integer (default 145)
    product_title — string for fallback aria-label
{% endcomment %}

{%- assign tp_rating = rating | default: 4.8 -%}
{%- assign tp_count  = review_count | default: 145 -%}
{%- assign tp_show_fallback = false -%}
{%- if tp_count < 10 -%}{%- assign tp_show_fallback = true -%}{%- endif -%}

<div class="tp-widget" aria-label="Betyg: {{ tp_rating }} av 5, {{ tp_count }} omdömen">
  {%- if tp_show_fallback -%}
    <div class="tp-widget__stars tp-widget__stars--gray" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- endfor -%}
    </div>
    <span class="tp-widget__fallback">Köpare rekommenderar detta</span>
  {%- else -%}
    <div class="tp-widget__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- endfor -%}
    </div>
    <span class="tp-widget__score">{{ tp_rating }}</span>
    <span class="tp-widget__divider" aria-hidden="true">|</span>
    <span class="tp-widget__count">{{ tp_count }} omdömen</span>
  {%- endif -%}
</div>

<style>
  .tp-widget {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .tp-widget__stars { display: flex; gap: 1px; }
  .tp-widget__stars svg {
    width: 12px; height: 12px;
    fill: #F59E0B;
  }
  .tp-widget__stars--gray svg { fill: #cccccc; }
  .tp-widget__score {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #F59E0B;
  }
  .tp-widget__divider {
    font-size: 11px;
    color: #cccccc;
  }
  .tp-widget__count {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #666666;
  }
  .tp-widget__fallback {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #666666;
    font-style: italic;
  }
</style>
