<style>
  .pb-rev { background: #FFFFFF; padding: 96px 0; overflow: hidden; }

  .pb-rev__header { text-align: center; max-width: 560px; margin: 0 auto 48px; padding: 0 20px; }
  .pb-rev__label {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase; color: #2d5a3d; margin-bottom: 12px;
  }
  .pb-rev__label::before { content: ''; display: block; width: 20px; height: 2px; background: #2d5a3d; }
  .pb-rev__title {
    font-family: 'Montserrat', sans-serif; font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 800; color: #000000; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 20px;
  }
  .pb-rev__meta { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .pb-rev__stars { display: flex; gap: 3px; }
  .pb-rev__stars svg { width: 16px; height: 16px; fill: #F59E0B; }
  .pb-rev__score { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700; color: #000000; }
  .pb-rev__count { font-family: 'Inter', sans-serif; font-size: 13px; color: #AAAAAA; }

  /* Carousel wrapper */
  .pb-rev__carousel {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4.5vw, 72px);
  }

  .pb-rev__track-outer {
    overflow: hidden;
    cursor: grab;
  }
  .pb-rev__track-outer:active { cursor: grabbing; }

  .pb-rev__track {
    display: flex;
    gap: 16px;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    user-select: none;
  }

  /* Cards */
  .pb-rev__card {
    flex: 0 0 calc(33.333% - 11px);
    background: #F9F9F9;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    overflow: hidden;
    border-bottom: 2px solid transparent;
    transition: border-color 300ms ease, background 300ms ease;
  }
  .pb-rev__card.is-active { border-bottom-color: #2d5a3d; background: #FFFFFF; }

  .pb-rev__card-stars { display: flex; gap: 2px; }
  .pb-rev__card-stars svg { width: 13px; height: 13px; fill: #F59E0B; }

  .pb-rev__card-text {
    font-family: 'Inter', sans-serif; font-size: 14px; line-height: 1.75;
    color: #444444; flex: 1;
  }
  .pb-rev__card-text::before { content: '\201C'; }
  .pb-rev__card-text::after  { content: '\201D'; }

  .pb-rev__card-author { display: flex; align-items: center; gap: 12px; }
  .pb-rev__card-avatar {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    background: #000000;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 700; color: #FFFFFF;
  }
  .pb-rev__card-name { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: #000000; text-transform: uppercase; letter-spacing: 0.4px; }
  .pb-rev__card-role { font-family: 'Inter', sans-serif; font-size: 11px; color: #AAAAAA; margin-top: 2px; }

  .pb-rev__verified {
    display: flex; align-items: center; gap: 4px;
    font-family: 'Inter', sans-serif; font-size: 10px; color: #AAAAAA;
  }
  .pb-rev__verified svg { width: 11px; height: 11px; color: #2d5a3d; }

  /* Nav arrows */
  .pb-rev__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; border-radius: 50%;
    background: #FFFFFF; border: 1.5px solid #E5E5E5;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 2;
    transition: all 200ms ease; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .pb-rev__arrow:hover { border-color: #2d5a3d; color: #2d5a3d; }
  .pb-rev__arrow svg { width: 16px; height: 16px; }
  .pb-rev__arrow--prev { left: 12px; }
  .pb-rev__arrow--next { right: 12px; }
  .pb-rev__arrow[disabled] { opacity: 0.3; pointer-events: none; }

  /* Dots */
  .pb-rev__dots {
    display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 36px;
  }
  .pb-rev__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #E5E5E5; border: none; cursor: pointer; padding: 0;
    transition: all 250ms ease;
  }
  .pb-rev__dot.is-active { background: #2d5a3d; transform: scale(1.4); }

  /* Mobile — 1 card */
  @media (max-width: 767px) {
    .pb-rev { padding: 64px 0; }
    .pb-rev__carousel { padding: 0; }
    .pb-rev__track-outer { padding: 0 20px; }
    .pb-rev__card { flex: 0 0 85vw; padding: 22px; }
    .pb-rev__arrow { display: none; }
  }

  /* Tablet — 2 cards */
  @media (min-width: 768px) and (max-width: 1023px) {
    .pb-rev__card { flex: 0 0 calc(50% - 8px); }
    .pb-rev__arrow--prev { left: 4px; }
    .pb-rev__arrow--next { right: 4px; }
  }
</style>

<section class="pb-rev">
  <div class="pb-rev__header">
    <p class="pb-rev__label">{{ section.settings.label | default: 'Kundrecensioner' }}</p>
    <h2 class="pb-rev__title">{{ section.settings.title | default: 'Det Säger Våra Kunder' }}</h2>
    <div class="pb-rev__meta">
      <div class="pb-rev__stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
      <span class="pb-rev__score">4.9 / 5</span>
      <span class="pb-rev__count">Baserat på 1 247 recensioner</span>
    </div>
  </div>

  <div class="pb-rev__carousel">
    <button class="pb-rev__arrow pb-rev__arrow--prev" id="pb-rev-prev" aria-label="Föregående">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="pb-rev__track-outer" id="pb-rev-outer">
      <div class="pb-rev__track" id="pb-rev-track">

        <div class="pb-rev__card is-active">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Köpte massagepistolen för att hantera träningsvärk och jag är helt imponerad. Djupvävnadsmassagen når precis rätt ställen och batteriet håller länge. Kan inte träna utan den nu.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">E</div><div><div class="pb-rev__card-name">Erik Svensson</div><div class="pb-rev__card-role">Löpare, Stockholm</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Perfekt för mig som sitter mycket på jobbet. Massagepistolen tar bort hela spänningen i nacke och axlar på under 10 minuter. Bästa köpet på länge!</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">M</div><div><div class="pb-rev__card-name">Maja Lindqvist</div><div class="pb-rev__card-role">Kontorsarbetare, Göteborg</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Som personlig tränare rekommenderar jag massagepistolen till alla mina klienter. Återhämtningen efter intensiva pass har förbättrats markant. Absolut värd priset.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">D</div><div><div class="pb-rev__card-name">Daniel Holm</div><div class="pb-rev__card-role">Personlig tränare, Malmö</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Var skeptisk till en början men efter en veckas användning förstår jag hypen. Axelsmärtan efter simträning är borta på minuter.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">S</div><div><div class="pb-rev__card-name">Sara Engström</div><div class="pb-rev__card-role">Simmare, Uppsala</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Jobbar 8+ timmar framför skärm varje dag. Sedan jag började använda blåljusglasögonen somnar jag snabbare och morgonhuvudvärken är helt borta. Värt varenda krona!</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">L</div><div><div class="pb-rev__card-name">Lina Bergström</div><div class="pb-rev__card-role">UX Designer, Stockholm</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Min sömn har förbättrats dramatiskt. Tar på mig glasögonen 2 timmar innan läggdags och skillnaden är enorm. Dessutom riktigt snygga – bär dem på jobbet också.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">J</div><div><div class="pb-rev__card-name">Johan Karlsson</div><div class="pb-rev__card-role">Programmerare, Lund</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Perfekta för gaming-sessioner på kvällen. Ögonen är inte längre röda och trötta efter långa spelsessioner. Designen är snygg och de sitter bekvämt hela natten.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">A</div><div><div class="pb-rev__card-name">Amanda Nilsson</div><div class="pb-rev__card-role">Content creator, Örebro</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Rekommenderar glasögonen till alla mina patienter med sömnproblem. Blåljusfilter i ett snyggt par glasögon är ett enkelt och effektivt sätt att förbättra sömnkvaliteten.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">T</div><div><div class="pb-rev__card-name">Thomas Ek</div><div class="pb-rev__card-role">Läkare, Linköping</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Armbandet är otroligt exakt med pulsmätningen. Sömnanalysen hjälpte mig förstå varför jag kände mig trött och nu har jag fullständigt optimerat min återhämtning.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">K</div><div><div class="pb-rev__card-name">Karin Johansson</div><div class="pb-rev__card-role">Yogalärare, Helsingborg</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Har haft dyra märkesarmband men detta slår dem på precision och batteritid. Stegräknaren är spot-on och sömndata är superdetaljerade. Rekommenderar starkt!</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">P</div><div><div class="pb-rev__card-name">Peter Lindgren</div><div class="pb-rev__card-role">Triatlet, Västerås</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Perfekt för oss som vill hålla koll på hälsan utan krångel! Enkel att använda, tydlig display och all data man behöver. Pulsen, stegen och sömnen – allt på handleden.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">E</div><div><div class="pb-rev__card-name">Eva Magnusson</div><div class="pb-rev__card-role">Pensionär, Jönköping</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Pilatesstaven är min favoritprodukt! Kan träna hela kroppen hemma på 20 minuter. Gummibanden ger precis rätt motstånd och den är lätt att ta med på resor.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">A</div><div><div class="pb-rev__card-name">Anna Persson</div><div class="pb-rev__card-role">Hemmatränare, Borås</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Köpte som present och nu tävlar vi om vem som får använda den! Benen, ryggen, armarna – hela kroppen med ett enda redskap. Bästa träningsinköpet vi gjort.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">H</div><div><div class="pb-rev__card-name">Henrik Strand</div><div class="pb-rev__card-role">Pappa & löpare, Norrköping</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Skadad rygg har gjort det omöjligt att gymma. Pilatesstaven ger mig ett skonsamt men effektivt alternativ hemma. Min fysioterapeut är verkligen imponerad av resultaten.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">C</div><div><div class="pb-rev__card-name">Cecilia Löf</div><div class="pb-rev__card-role">Rehabilitering, Gävle</div></div></div>
        </div>

        <div class="pb-rev__card">
          <div class="pb-rev__card-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <p class="pb-rev__card-text">Tränar triathlon och armbandet ger mig all data jag behöver – pulszoner, sömnkvalitet och dagliga steg. Allt i en stilren och bekväm enhet. Har redan rekommenderat till laget.</p>
          <div class="pb-rev__verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Verifierat köp</div>
          <div class="pb-rev__card-author"><div class="pb-rev__card-avatar">M</div><div><div class="pb-rev__card-name">Marcus Berg</div><div class="pb-rev__card-role">Cyklist, Umeå</div></div></div>
        </div>

      </div>
    </div>

    <button class="pb-rev__arrow pb-rev__arrow--next" id="pb-rev-next" aria-label="Nästa">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>

  <div class="pb-rev__dots" id="pb-rev-dots"></div>
</section>

<script>
(function () {
  var outer   = document.getElementById('pb-rev-outer');
  var track   = document.getElementById('pb-rev-track');
  var btnPrev = document.getElementById('pb-rev-prev');
  var btnNext = document.getElementById('pb-rev-next');
  var dotsEl  = document.getElementById('pb-rev-dots');
  var cards   = Array.from(track.children);

  var perView = 3;
  var current = 0;
  var total;

  function getPerView() {
    if (window.innerWidth < 768) return 1;
    if (window.innerWidth < 1024) return 2;
    return 3;
  }

  function buildDots() {
    dotsEl.innerHTML = '';
    for (var i = 0; i < total; i++) {
      var d = document.createElement('button');
      d.className = 'pb-rev__dot' + (i === 0 ? ' is-active' : '');
      d.dataset.i = i;
      d.addEventListener('click', function () { goTo(+this.dataset.i); });
      dotsEl.appendChild(d);
    }
  }

  function goTo(idx) {
    perView = getPerView();
    total = Math.ceil(cards.length / perView);
    current = Math.max(0, Math.min(idx, total - 1));

    var cardWidth = cards[0].getBoundingClientRect().width;
    var gap = 16;
    var offset = current * perView * (cardWidth + gap);
    track.style.transform = 'translateX(-' + offset + 'px)';

    cards.forEach(function (c, i) {
      var inView = i >= current * perView && i < (current + 1) * perView;
      c.classList.toggle('is-active', inView);
    });

    var dots = dotsEl.querySelectorAll('.pb-rev__dot');
    dots.forEach(function (d, i) { d.classList.toggle('is-active', i === current); });

    btnPrev.disabled = current === 0;
    btnNext.disabled = current >= total - 1;
  }

  function init() {
    perView = getPerView();
    total = Math.ceil(cards.length / perView);
    buildDots();
    goTo(0);
  }

  btnPrev.addEventListener('click', function () { goTo(current - 1); });
  btnNext.addEventListener('click', function () { goTo(current + 1); });

  /* Touch / drag swipe */
  var startX = 0;
  outer.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
  outer.addEventListener('touchend', function (e) {
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
  });
  var dragStart = 0; var isDragging = false;
  outer.addEventListener('mousedown', function (e) { isDragging = true; dragStart = e.clientX; });
  window.addEventListener('mouseup', function (e) {
    if (!isDragging) return; isDragging = false;
    var diff = dragStart - e.clientX;
    if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
  });

  window.addEventListener('resize', init);
  init();
})();
</script>

