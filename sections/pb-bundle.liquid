<style>
  .pb-bundle {
    font-family: 'Inter', sans-serif;
    margin: 0;
    padding: 32px 0;
  }
  .pb-bundle__title {
    font-family: 'Montserrat', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }
  .pb-bundle__options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
  }
  .pb-bundle__option {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1.5px solid #e5e5e5;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease;
    background: #fff;
    position: relative;
  }
  .pb-bundle__option:hover {
    border-color: #2d5a3d;
  }
  .pb-bundle__option.is-selected {
    border-color: #2d5a3d;
    background: #f4f8f5;
  }
  .pb-bundle__option.is-selected .pb-bundle__radio-dot {
    background: #2d5a3d;
  }

  /* Badge t.ex. "Populärast" */
  .pb-bundle__badge {
    position: absolute;
    top: -10px;
    left: 16px;
    background: #2d5a3d;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 8px;
  }

  /* Radio */
  .pb-bundle__radio {
    width: 18px;
    height: 18px;
    border: 1.5px solid #cccccc;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 200ms ease;
  }
  .pb-bundle__option.is-selected .pb-bundle__radio {
    border-color: #2d5a3d;
  }
  .pb-bundle__radio-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: transparent;
    transition: background 200ms ease;
  }

  /* Text */
  .pb-bundle__option-info {
    flex: 1;
  }
  .pb-bundle__option-qty {
    font-size: 14px;
    font-weight: 700;
    color: #000;
  }
  .pb-bundle__option-label {
    font-size: 12px;
    color: #555555;
    margin-top: 1px;
  }

  /* Pris */
  .pb-bundle__option-price {
    text-align: right;
    flex-shrink: 0;
  }
  .pb-bundle__option-price-main {
    font-size: 15px;
    font-weight: 700;
    color: #000;
  }
  .pb-bundle__option-price-save {
    font-size: 12px;
    color: #2d5a3d;
    font-weight: 600;
    margin-top: 1px;
  }
  .pb-bundle__option-price-each {
    font-size: 11px;
    color: #aaaaaa;
    margin-top: 1px;
  }

  /* ATC-knapp */
  .pb-bundle__atc-btn {
    width: 100%;
    background: #2d5a3d;
    color: #ffffff;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .pb-bundle__atc-btn:hover {
    background: #1e3d2a;
    transform: translateY(-1px);
  }

  /* Divider */
  .pb-bundle__divider {
    height: 1px;
    background: #e5e5e5;
    margin-bottom: 20px;
  }
</style>

{%- liquid
  assign bundle_meta = product.metafields.custom.bundle_options
  assign base_price  = product.selected_or_first_available_variant.price
-%}

{%- if bundle_meta != blank -%}
  {%- assign bundle_items = bundle_meta.value -%}

  <section class="pb-bundle">
    <div class="pb-container">
      <div class="pb-bundle__divider"></div>
      <div class="pb-bundle__title">{{ section.settings.title | default: 'Välj ditt paket' }}</div>

      <div class="pb-bundle__options" id="pb-bundle-options">
        {%- for item in bundle_items -%}
          {%- assign total_price  = base_price | times: item.qty -%}
          {%- assign discount_pct = item.discount | plus: 0 -%}
          {%- assign save_amount  = total_price | times: discount_pct | divided_by: 100 -%}
          {%- assign final_price  = total_price | minus: save_amount -%}
          {%- assign price_each   = final_price | divided_by: item.qty -%}

          <div
            class="pb-bundle__option{% if forloop.first %} is-selected{% endif %}"
            data-qty="{{ item.qty }}"
            data-price="{{ final_price }}"
            data-discount="{{ item.discount }}"
            role="radio"
            aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="0"
          >
            {%- if item.badge != blank -%}
              <span class="pb-bundle__badge">{{ item.badge }}</span>
            {%- endif -%}

            <div class="pb-bundle__radio">
              <div class="pb-bundle__radio-dot"></div>
            </div>

            <div class="pb-bundle__option-info">
              <div class="pb-bundle__option-qty">{{ item.qty }} st</div>
              {%- if item.label != blank -%}
                <div class="pb-bundle__option-label">{{ item.label }}</div>
              {%- endif -%}
            </div>

            <div class="pb-bundle__option-price">
              <div class="pb-bundle__option-price-main">{{ final_price | money }}</div>
              {%- if discount_pct > 0 -%}
                <div class="pb-bundle__option-price-save">Spara {{ save_amount | money }}</div>
              {%- endif -%}
              <div class="pb-bundle__option-price-each">{{ price_each | money }} / st</div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- form 'product', product, id: 'pb-bundle-form' -%}
        <input type="hidden" name="id"       value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1" id="pb-bundle-qty">
        <button type="submit" class="pb-bundle__atc-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span id="pb-bundle-atc-label">{{ section.settings.atc_label | default: 'Lägg till i varukorg' }}</span>
        </button>
      {%- endform -%}

    </div>
  </section>

  <script>
  (function () {
    var options  = document.querySelectorAll('#pb-bundle-options .pb-bundle__option');
    var qtyInput = document.getElementById('pb-bundle-qty');
    var btnLabel = document.getElementById('pb-bundle-atc-label');
    var defaultLabel = btnLabel ? btnLabel.textContent : 'Lägg till i varukorg';

    function selectOption(el) {
      options.forEach(function (o) {
        o.classList.remove('is-selected');
        o.setAttribute('aria-checked', 'false');
      });
      el.classList.add('is-selected');
      el.setAttribute('aria-checked', 'true');

      var qty = parseInt(el.dataset.qty, 10) || 1;
      if (qtyInput) qtyInput.value = qty;
      if (btnLabel) btnLabel.textContent = qty > 1
        ? defaultLabel + ' (' + qty + ' st)'
        : defaultLabel;
    }

    options.forEach(function (el) {
      el.addEventListener('click', function () { selectOption(el); });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectOption(el); }
      });
    });
  })();
  </script>

{%- endif -%}

{% schema %}
{
  "name": "PB – Bundle",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title",     "label": "Rubrik",               "default": "Välj ditt paket" },
    { "type": "text", "id": "atc_label", "label": "Lägg i kundvagn-text", "default": "Lägg till i varukorg" }
  ],
  "presets": [{ "name": "PB – Bundle" }]
}
{% endschema %}