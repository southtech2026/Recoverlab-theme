<section class="pb-problem-solution">
  <div class="pb-container">
    <div style="text-align:center;max-width:560px;margin:0 auto 64px;">
      <p class="pb-label pb-label--white pb-fade-in">{{ section.settings.label | default: 'Problemet & lösningen' }}</p>
      <h2 class="pb-heading-lg pb-fade-in pb-fade-in--d1" style="color:var(--pb-white);">{{ section.settings.title | default: 'Vi Förstår Problemet' }}</h2>
    </div>
    <div class="pb-problem-solution__grid pb-fade-in pb-fade-in--d2">
      <div class="pb-ps-side pb-ps-side--problem">
        <div class="pb-ps-side__label">⚠ {{ section.settings.problem_label | default: 'Utan rätt återhämtning' }}</div>
        <h3 class="pb-ps-side__title">{{ section.settings.problem_title | default: 'Kroppen fastnar i ett destruktivt mönster' }}</h3>
        <p class="pb-ps-side__text">{{ section.settings.problem_text | default: 'Utan rätt återhämtning bryts muskler ner istället för att byggas upp. Kortisolet stiger. Sömnen försämras. Energin sjunker. Det är en nedåtgående spiral som drabbar 73% av aktiva swenskar.' }}</p>
        <div class="pb-ps-side__items">
          {%- for block in section.blocks -%}
            {%- if block.type == 'problem' -%}
              <div class="pb-ps-item" {{ block.shopify_attributes }}>
                <svg class="pb-ps-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="pb-ps-side pb-ps-side--solution">
        <div class="pb-ps-side__label">✓ {{ section.settings.solution_label | default: 'Med vår produkt' }}</div>
        <h3 class="pb-ps-side__title">{{ section.settings.solution_title | default: 'Din kropp får vad den verkligen behöver' }}</h3>
        <p class="pb-ps-side__text">{{ section.settings.solution_text | default: 'Vår vetenskapligt formulerade produkt ger kroppen de exakta närämnena den behöver för optimal återhämtning – i rätt doser, vid rätt tidpunkt.' }}</p>
        <div class="pb-ps-side__items">
          {%- for block in section.blocks -%}
            {%- if block.type == 'solution' -%}
              <div class="pb-ps-item" {{ block.shopify_attributes }}>
                <svg class="pb-ps-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PB — Problem / Solution",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Problemet & lösningen" },
    { "type": "text", "id": "title", "label": "Title", "default": "Vi Förstår Problemet" },
    { "type": "text", "id": "problem_label", "label": "Problem label", "default": "Utan rätt återhämtning" },
    { "type": "text", "id": "problem_title", "label": "Problem title", "default": "Kroppen fastnar i ett destruktivt mönster" },
    { "type": "textarea", "id": "problem_text", "label": "Problem text", "default": "Utan rätt återhämtning bryts muskler ner istället för att byggas upp. Kortisolet stiger. Sömnen försämras. Energin sjunker." },
    { "type": "text", "id": "solution_label", "label": "Solution label", "default": "Med vår produkt" },
    { "type": "text", "id": "solution_title", "label": "Solution title", "default": "Din kropp får vad den verkligen behöver" },
    { "type": "textarea", "id": "solution_text", "label": "Solution text", "default": "Vår vetenskapligt formulerade produkt ger kroppen de exakta närämnena den behöver för optimal återhämtning." }
  ],
  "blocks": [
    { "type": "problem", "name": "Problem item", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "solution", "name": "Solution item", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }
  ],
  "presets": [{
    "name": "PB — Problem / Solution",
    "blocks": [
      { "type": "problem", "settings": { "text": "Muskelvärk i 3–5 dagar efter träning" } },
      { "type": "problem", "settings": { "text": "Dålig sömnkvalitet och orolig sömn" } },
      { "type": "problem", "settings": { "text": "Låg energi och trötthet under dagen" } },
      { "type": "problem", "settings": { "text": "Svårt att prestera på nästa pass" } },
      { "type": "solution", "settings": { "text": "Minskar muskelvärk med upp till 60%" } },
      { "type": "solution", "settings": { "text": "Djupare REM-sömn varje natt" } },
      { "type": "solution", "settings": { "text": "Naturlig energi som varar hela dagen" } },
      { "type": "solution", "settings": { "text": "Redo för nästa träningspass på 24h" } }
    ]
  }]
}
{% endschema %}
