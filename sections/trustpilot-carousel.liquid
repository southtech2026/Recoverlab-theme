{% comment %}
  Trustpilot Carousel — uses official TrustBox widget when business_unit_id is set,
  falls back to static reviews otherwise.

  HOW TO GET YOUR BUSINESS UNIT ID:
  1. Log in to business.trustpilot.com
  2. Go to Settings → Business Unit
  3. Copy the 24-character ID from the URL or API section
     Example: 5abc1234def5678901234567
  4. Paste it in the Theme Editor under this section's settings
{% endcomment %}

<style>
  .tp-section {
    background: #ffffff;
    padding: 60px clamp(20px, 5vw, 80px);
  }
  .tp-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .tp-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .tp-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tp-meta__stars     { display: flex; gap: 2px; }
  .tp-meta__stars svg { width: 17px; height: 17px; fill: #00b67a; }
  .tp-meta__score     { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; color: #000; }
  .tp-meta__count     { font-family: 'Inter', sans-serif; font-size: 13px; color: #666; }
  .tp-meta__logo      { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: #00b67a; text-decoration: none; }

  .tp-cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700;
    color: #000; text-decoration: none; border: 1.5px solid #000;
    padding: 9px 18px; transition: background 200ms, color 200ms;
    white-space: nowrap; flex-shrink: 0; align-self: center;
  }
  .tp-cta:hover { background: #000; color: #fff; }
  .tp-cta svg { width: 12px; height: 12px; }

  /* ── TrustBox wrapper ── */
  .tp-trustbox-wrap {
    min-height: 200px;
  }

  /* ── Static carousel fallback ── */
  .tp-carousel-wrap { position: relative; }
  .tp-carousel { overflow: hidden; cursor: grab; }
  .tp-carousel:active { cursor: grabbing; }
  .tp-track { display: flex; gap: 16px; will-change: transform; user-select: none; }

  .tp-card {
    background: #fff; border: 1px solid #e8e8e8; border-radius: 8px;
    padding: 24px; flex-shrink: 0; display: flex; flex-direction: column; gap: 12px;
    transition: box-shadow 250ms ease;
  }
  .tp-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
  .tp-card__stars     { display: flex; gap: 2px; }
  .tp-card__stars svg { width: 15px; height: 15px; fill: #00b67a; }
  .tp-card__title { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; color: #000; margin: 0; }
  .tp-card__text  {
    font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.7; color: #444; margin: 0; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }
  .tp-card__footer {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding-top: 12px; border-top: 1px solid #f0f0f0 !important;
    background: #ffffff !important;
    background-color: #ffffff !important;
  }
  .tp-card__footer * { background: transparent !important; }
  .tp-card__name { font-family: 'Inter', sans-serif !important; font-size: 13px !important; font-weight: 700 !important; color: #000000 !important; text-transform: uppercase; letter-spacing: 0.3px; }
  .tp-card__date { font-family: 'Inter', sans-serif !important; font-size: 11px !important; color: #888888 !important; margin-top: 2px; }
  .tp-card__verified { display: flex; align-items: center; gap: 3px; font-family: 'Inter', sans-serif !important; font-size: 10px !important; color: #00b67a !important; font-weight: 600; }
  .tp-card__verified svg { width: 11px; height: 11px; color: #00b67a !important; }

  .tp-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; border-radius: 50%;
    background: #fff; border: 1.5px solid #e5e5e5;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 2; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: all 200ms;
  }
  .tp-arrow:hover   { border-color: #000; }
  .tp-arrow:disabled{ opacity: 0.3; pointer-events: none; }
  .tp-arrow svg { width: 14px; height: 14px; }
  .tp-arrow--prev { left: -20px; }
  .tp-arrow--next { right: -20px; }

  .tp-dots { display: flex; justify-content: center; gap: 7px; margin-top: 28px; }
  .tp-dot  { width: 7px; height: 7px; border-radius: 50%; background: #ccc; border: none; cursor: pointer; padding: 0; transition: background 250ms, transform 250ms; }
  .tp-dot.is-active { background: #00b67a; transform: scale(1.4); }

  .tp-footer {
    text-align: center;
    margin-top: 36px;
    background: #ffffff !important;
    background-color: #ffffff !important;
  }
  .tp-footer-btn {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #00b67a !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    padding: 14px 32px;
    text-decoration: none !important;
    border-radius: 4px;
    border: 2px solid #00b67a !important;
    transition: background 200ms, color 200ms, transform 200ms;
  }
  .tp-footer-btn:hover {
    background: #00b67a !important;
    color: #ffffff !important;
    transform: translateY(-2px);
  }
  .tp-footer-btn * { color: inherit !important; background: transparent !important; }

  @media (max-width: 767px) {
    .tp-section  { padding: 48px 20px; }
    .tp-arrow    { display: none; }
  }
</style>

<section class="tp-section">

  <div class="tp-header">
    <div>
      <h2 class="tp-heading">{{ section.settings.heading | default: 'Recensioner från våra kunder' }}</h2>
      <div class="tp-meta">
        <div class="tp-meta__stars" aria-hidden="true">
          {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}
        </div>
        <span class="tp-meta__score">4.9 / 5</span>
        <span class="tp-meta__count">— {{ section.settings.review_count | default: '1 247' }} omdömen</span>
        <a class="tp-meta__logo" href="https://www.trustpilot.com/review/recoverlab.se" target="_blank" rel="noopener">★ Trustpilot</a>
      </div>
    </div>
    <a href="https://www.trustpilot.com/review/recoverlab.se" target="_blank" rel="noopener" class="tp-cta">
      Se alla omdömen
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  {%- if section.settings.business_unit_id != blank and section.settings.business_unit_id != 'KLISTRA_IN_HEX_ID_HÄR' -%}

    {%- comment -%} ── Official TrustBox Carousel ── {%- endcomment -%}
    <div class="tp-trustbox-wrap">
      <div
        class="trustpilot-widget"
        data-locale="sv-SE"
        data-template-id="53aa8912dec7e10d38f59f36"
        data-businessunit-id="{{ section.settings.business_unit_id }}"
        data-style-height="240px"
        data-style-width="100%"
        data-theme="light"
        data-stars="4,5"
        data-review-languages="sv,en"
      >
        <a href="https://www.trustpilot.com/review/recoverlab.se" target="_blank" rel="noopener">Trustpilot</a>
      </div>
    </div>

  {%- else -%}

    {%- comment -%} ── Static fallback carousel ── {%- endcomment -%}
    <div class="tp-carousel-wrap">
      <button type="button" class="tp-arrow tp-arrow--prev" data-tp-prev aria-label="Föregående" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="tp-carousel" data-tp-carousel data-tp-interval="{{ section.settings.auto_speed | default: 4000 }}">
        <div class="tp-track" data-tp-track>
          {%- for block in section.blocks -%}
            <div class="tp-card" data-tp-card {{ block.shopify_attributes }}>
              <div class="tp-card__stars" aria-label="{{ block.settings.stars }} av 5">
                {%- for i in (1..5) -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="{% if i > block.settings.stars %}opacity:0.2{% endif %}"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endfor -%}
              </div>
              {%- if block.settings.title != blank -%}
                <p class="tp-card__title">{{ block.settings.title }}</p>
              {%- endif -%}
              <p class="tp-card__text">{{ block.settings.review }}</p>
              <div class="tp-card__footer">
                <div>
                  <div class="tp-card__name">{{ block.settings.name }}</div>
                  <div class="tp-card__date">{{ block.settings.date }}</div>
                </div>
                <div class="tp-card__verified">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  Verifierat
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <button type="button" class="tp-arrow tp-arrow--next" data-tp-next aria-label="Nästa">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    <div class="tp-dots" data-tp-dots></div>

  {%- endif -%}

  <div class="tp-footer">
    <a href="https://www.trustpilot.com/review/recoverlab.se" target="_blank" rel="noopener" class="tp-footer-btn" style="background:#ffffff !important; color:#00b67a !important; border:2px solid #00b67a !important;">
      Se alla omdömen på Trustpilot →
    </a>
  </div>

</section>

<script src="{{ 'trustpilot.js' | asset_url }}" defer></script>

{%- if section.settings.business_unit_id != blank and section.settings.business_unit_id != 'KLISTRA_IN_HEX_ID_HÄR' -%}
  <script src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Trustpilot Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Trustpilot Business Unit ID"
    },
    {
      "type": "text",
      "id": "business_unit_id",
      "label": "Business Unit ID (24-teckens hex)",
      "info": "Hämta ditt ID: business.trustpilot.com → Settings → Business Unit. Lämna tomt för att visa statiska recensioner.",
      "placeholder": "t.ex. 5abc1234def5678901234567"
    },
    {
      "type": "header",
      "content": "Innehåll"
    },
    { "type": "text",  "id": "heading",      "label": "Rubrik",           "default": "Recensioner från våra kunder" },
    { "type": "text",  "id": "review_count", "label": "Antal omdömen",    "default": "1 247" },
    { "type": "range", "id": "auto_speed",   "label": "Auto-scroll (ms)", "min": 2000, "max": 8000, "step": 500, "default": 4000 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recension (statisk)",
      "settings": [
        { "type": "range",    "id": "stars",  "label": "Betyg",         "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text",     "id": "title",  "label": "Rubrik"         },
        { "type": "textarea", "id": "review", "label": "Recensionstext" },
        { "type": "text",     "id": "name",   "label": "Kundnamn"       },
        { "type": "text",     "id": "date",   "label": "Datum"          }
      ]
    }
  ],
  "presets": [{
    "name": "Trustpilot Carousel",
    "blocks": [
      { "type": "review", "settings": { "stars": 5, "title": "Bästa massagepistolen!", "review": "Köpte massagepistolen för att hantera träningsvärk och jag är helt imponerad. Djupvävnadsmassagen når precis rätt ställen. Kan inte träna utan den nu.", "name": "Erik S.", "date": "15 maj 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "Sover som ett barn nu", "review": "Blåljusglasögonen har förändrat min sömnkvalitet helt. Tar på dem 2 timmar innan läggdags och skillnaden är dramatisk.", "name": "Lina B.", "date": "12 maj 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "Imponerad av träningsbandet", "review": "Armbandet är otroligt exakt med pulsmätningen. Sömnanalysen hjälpte mig förstå varför jag kände mig trött.", "name": "Karin J.", "date": "8 maj 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "Tränar hemma varje dag", "review": "Pilatesstaven är min favoritprodukt! Kan träna hela kroppen på 20 minuter. Gummibanden ger precis rätt motstånd.", "name": "Anna P.", "date": "5 maj 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "Snabb leverans, top kvalitet", "review": "Beställde på måndag, fick paketet på onsdag. Produkten överträffade förväntningarna – premium kvalitet till ett rimligt pris.", "name": "Marcus B.", "date": "2 maj 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "Rekommenderar starkt", "review": "Har provat många liknande produkter men Recoverlab är i en helt annan klass. Snabb leverans och riktigt bra kundtjänst.", "name": "Sofia A.", "date": "28 apr 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "Perfekt present", "review": "Köpte pilatesstaven som present och nu tävlar vi om vem som får använda den! Bästa träningsinköpet vi gjort.", "name": "Henrik S.", "date": "22 apr 2026" } },
      { "type": "review", "settings": { "stars": 5, "title": "PT-nivå hemma", "review": "Som personlig tränare rekommenderar jag Recoverlabs produkter till alla mina klienter. Återhämtningen har förbättrats markant.", "name": "Daniel H.", "date": "18 apr 2026" } }
    ]
  }]
}
{% endschema %}
