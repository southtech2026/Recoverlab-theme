{% style %}
  .pb-footer-wrap {
    background: #000000;
    color: #555555;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
  }
  .pb-footer-top {
    padding: 72px clamp(20px, 4.5vw, 72px) 56px;
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .pb-footer-brand__name {
    font-family: 'Poppins', sans-serif;
    font-size: 22px;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin-bottom: 14px;
    display: block;
    text-decoration: none;
  }
  .pb-footer-brand__tagline {
    font-size: 13px;
    line-height: 1.72;
    color: #444444;
    max-width: 280px;
    margin-bottom: 28px;
  }
  .pb-footer-brand__email a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #555555;
    text-decoration: none;
    transition: color 160ms ease;
    font-weight: 500;
  }
  .pb-footer-brand__email a:hover { color: #FFFFFF; }
  .pb-footer-brand__email svg { width: 14px; height: 14px; color: #1B365D; }
  .pb-footer-col__heading {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 20px;
    display: block;
  }
  .pb-footer-col__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pb-footer-col__links a {
    font-size: 13px;
    color: #555555;
    text-decoration: none;
    transition: color 160ms ease;
    font-weight: 400;
  }
  .pb-footer-col__links a:hover { color: #FFFFFF; }

  /* Newsletter */
  .pb-footer-newsletter__title {
    font-size: 13px;
    color: #FFFFFF;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .pb-footer-newsletter__sub {
    font-size: 12px;
    color: #444444;
    margin-bottom: 16px;
    line-height: 1.6;
  }
  .pb-footer-newsletter__form { display: flex; gap: 0; }
  .pb-footer-newsletter__input {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-right: none;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    padding: 12px 16px;
    outline: none;
    transition: border-color 180ms ease;
  }
  .pb-footer-newsletter__input::placeholder { color: rgba(255,255,255,0.25); }
  .pb-footer-newsletter__input:focus { border-color: rgba(27,54,93,0.6); }
  .pb-footer-newsletter__btn {
    background: #1B365D;
    color: #FFFFFF;
    border: none;
    padding: 12px 20px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease;
    white-space: nowrap;
  }
  .pb-footer-newsletter__btn:hover { background: #142840; }

  /* Divider */
  .pb-footer-divider {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.06);
    margin: 0;
  }

  /* Bottom bar */
  .pb-footer-bottom {
    max-width: 1320px;
    margin: 0 auto;
    padding: 20px clamp(20px, 4.5vw, 72px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .pb-footer-bottom__copy {
    font-size: 11px;
    color: rgba(255,255,255,0.2);
  }
  .pb-footer-bottom__links {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pb-footer-bottom__links a {
    font-size: 11px;
    color: rgba(255,255,255,0.25);
    text-decoration: none;
    transition: color 160ms ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }
  .pb-footer-bottom__links a:hover { color: rgba(255,255,255,0.7); }

  /* Payment icons */
  .pb-footer-payment {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .pb-footer-payment__icon {
    height: 22px;
    opacity: 0.35;
    filter: grayscale(100%) brightness(2);
    transition: opacity 160ms ease;
  }
  .pb-footer-payment__icon:hover { opacity: 0.65; }

  /* Social icons */
  .pb-footer-social {
    display: flex;
    gap: 14px;
    margin-top: 20px;
  }
  .pb-footer-social a {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: all 160ms ease;
  }
  .pb-footer-social a:hover { border-color: #1B365D; color: #FFFFFF; background: #1B365D; }
  .pb-footer-social svg { width: 16px; height: 16px; }

  @media (max-width: 1024px) {
    .pb-footer-top { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 640px) {
    .pb-footer-top { grid-template-columns: 1fr; gap: 36px; }
    .pb-footer-bottom { flex-direction: column; align-items: flex-start; gap: 16px; }
    .pb-footer-newsletter__form { flex-direction: column; }
    .pb-footer-newsletter__input { border-right: 1px solid rgba(255,255,255,0.1); border-bottom: none; }
  }
{% endstyle %}

<footer class="pb-footer-wrap">
  <div style="padding: 16px clamp(20px,4.5vw,72px); border-bottom: 1px solid rgba(255,255,255,0.06);">
    {%- render 'trustpilot-badge' -%}
  </div>
  <div class="pb-footer-top">

    <!-- Brand column -->
    <div class="pb-footer-brand">
      {%- if section.settings.logo != blank -%}
        {%- comment -%} Logo image uploaded — show it white/inverted for dark footer {%- endcomment -%}
        <a href="/" style="display:block;margin-bottom:18px;">
          <img
            src="{{ section.settings.logo | image_url: height: 56 }}"
            alt="{{ section.settings.brand_name | default: 'RECOVERLAB.SE' }}"
            style="height:56px;width:auto;filter:brightness(0) invert(1);"
            loading="lazy"
          >
        </a>
      {%- else -%}
        {%- comment -%} Text logo fallback — styled as RECOVERLAB.SE brand {%- endcomment -%}
        <a href="/" style="
          display:inline-block;
          margin-bottom:18px;
          font-family:'Poppins','Space Grotesk',sans-serif;
          font-size:20px;
          font-weight:900;
          letter-spacing:0.06em;
          text-transform:uppercase;
          color:#FFFFFF;
          text-decoration:none;
          line-height:1;
        ">{{ section.settings.brand_name | default: 'RECOVERLAB.SE' }}</a>
      {%- endif -%}
      <p class="pb-footer-brand__tagline">{{ section.settings.tagline | default: 'Premium produkter för din träning, återhämtning och hälsa. Vetenskapligt formulerat för atleter.' }}</p>
      <div class="pb-footer-brand__email">
        <a href="mailto:{{ section.settings.email | default: 'kontakt@recoverlabs.se' }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          {{ section.settings.email | default: 'kontakt@recoverlabs.se' }}
        </a>
      </div>
      <div class="pb-footer-social">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook != blank -%}
          <a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.24 8.24 0 0 0 4.82 1.54V6.78a4.85 4.85 0 0 1-1.05-.09z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Products column -->
    <div class="pb-footer-col">
      <span class="pb-footer-col__heading">{{ section.settings.col1_title | default: 'Produkter' }}</span>
      <ul class="pb-footer-col__links">
        {%- for block in section.blocks -%}
          {%- if block.type == 'col1_link' -%}
            <li><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.blocks == empty or section.blocks.size == 0 -%}
          <li><a href="/collections/all">Alla produkter</a></li>
          <li><a href="/collections/supplements">Kosttillskott</a></li>
          <li><a href="/collections/recovery">Återhämtning</a></li>
          <li><a href="/collections/equipment">Träningsutrustning</a></li>
          <li><a href="/collections/new">Nyheter</a></li>
        {%- endif -%}
      </ul>
    </div>

    <!-- Info column -->
    <div class="pb-footer-col">
      <span class="pb-footer-col__heading">{{ section.settings.col2_title | default: 'Information' }}</span>
      <ul class="pb-footer-col__links">
        {%- for block in section.blocks -%}
          {%- if block.type == 'col2_link' -%}
            <li><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.blocks == empty or section.blocks.size == 0 -%}
          <li><a href="/pages/about">Om oss</a></li>
          <li><a href="/pages/contact">Kontakta oss</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/blogs/news">Blogg</a></li>
        {%- endif -%}
      </ul>
    </div>

    <!-- Newsletter column -->
    <div class="pb-footer-col">
      <span class="pb-footer-col__heading">Nyhetsbrev</span>
      <p class="pb-footer-newsletter__title">{{ section.settings.newsletter_title | default: 'Exklusiva erbjudanden' }}</p>
      <p class="pb-footer-newsletter__sub">{{ section.settings.newsletter_sub | default: 'Prenumerera och få 10% rabatt på din första order.' }}</p>
      {%- form 'customer', class: 'pb-footer-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="pb-footer-newsletter__input"
          placeholder="{{ section.settings.newsletter_placeholder | default: 'Din e-postadress' }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="pb-footer-newsletter__btn">{{ section.settings.newsletter_btn | default: 'Prenumerera' }}</button>
      {%- endform -%}
    </div>

  </div>

  <hr class="pb-footer-divider">

  <div class="pb-footer-bottom">
    <p class="pb-footer-bottom__copy">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Recoverlabs' }}. Alla rättigheter förbehållna.
    </p>
    <ul class="pb-footer-bottom__links">
      <li><a href="/policies/privacy-policy">Integritetspolicy</a></li>
      <li><a href="/policies/terms-of-service">Villkor</a></li>
      <li><a href="/policies/refund-policy">Returpolicy</a></li>
      <li><a href="/policies/shipping-policy">Frakt</a></li>
    </ul>
    <div class="pb-footer-payment">
      {{ shop.enabled_payment_types | payment_type_svg_tag: class: 'pb-footer-payment__icon' }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "PB - Footer (Recoverlabs)",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo",             "label": "Logo image (white version)" },
    { "type": "text",         "id": "brand_name",        "label": "Brand name",          "default": "Recoverlabs" },
    { "type": "text",         "id": "tagline",           "label": "Brand tagline",        "default": "Premium produkter för din träning, återhämtning och hälsa. Vetenskapligt formulerat för atleter." },
    { "type": "text",         "id": "email",             "label": "Contact email",        "default": "kontakt@recoverlabs.se" },
    { "type": "header",       "content": "Social media" },
    { "type": "url",          "id": "instagram",         "label": "Instagram URL" },
    { "type": "url",          "id": "facebook",          "label": "Facebook URL" },
    { "type": "url",          "id": "tiktok",            "label": "TikTok URL" },
    { "type": "header",       "content": "Column headings" },
    { "type": "text",         "id": "col1_title",        "label": "Column 1 title",       "default": "Produkter" },
    { "type": "text",         "id": "col2_title",        "label": "Column 2 title",       "default": "Information" },
    { "type": "header",       "content": "Newsletter" },
    { "type": "text",         "id": "newsletter_title",  "label": "Newsletter title",     "default": "Exklusiva erbjudanden" },
    { "type": "text",         "id": "newsletter_sub",    "label": "Newsletter subtitle",  "default": "Prenumerera och få 10% rabatt på din första order." },
    { "type": "text",         "id": "newsletter_placeholder","label":"Input placeholder", "default": "Din e-postadress" },
    { "type": "text",         "id": "newsletter_btn",    "label": "Button label",         "default": "Prenumerera" }
  ],
  "blocks": [
    { "type": "col1_link", "name": "Column 1 link", "settings": [
      { "type": "text", "id": "label", "label": "Link label" },
      { "type": "url",  "id": "url",   "label": "Link URL" }
    ]},
    { "type": "col2_link", "name": "Column 2 link", "settings": [
      { "type": "text", "id": "label", "label": "Link label" },
      { "type": "url",  "id": "url",   "label": "Link URL" }
    ]}
  ],
  "presets": [{ "name": "PB - Footer (Recoverlabs)" }]
}
{% endschema %}
