<style>
  .rl-hero {
    position: relative;
    height: 500px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
  }

  .rl-hero__img,
  .rl-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .rl-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .rl-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 clamp(20px, 5vw, 80px);
    max-width: 860px;
    width: 100%;
  }

  .rl-hero__title {
    font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .rl-hero__subtitle {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #f5f5f5;
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .rl-hero__btn {
    display: inline-block;
    background: #ff6b35;
    color: #ffffff;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    font-weight: 600;
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .rl-hero__btn:hover {
    background: #e85c2b;
    transform: translateY(-2px);
    color: #ffffff;
  }

  /* Tablet */
  @media (max-width: 1199px) and (min-width: 768px) {
    .rl-hero { height: 400px; }
    .rl-hero__title { font-size: 36px; }
    .rl-hero__subtitle { font-size: 16px; }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .rl-hero { height: 300px; }
    .rl-hero__title { font-size: 28px; }
    .rl-hero__subtitle { font-size: 15px; margin-bottom: 24px; }
    .rl-hero__btn { width: 80%; text-align: center; }
  }
</style>

<section class="rl-hero">
  {%- if section.settings.video_url != blank -%}
    <video
      class="rl-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- elsif section.settings.image != blank -%}
    <img
      class="rl-hero__img"
      src="{{ section.settings.image | image_url: width: 1200 }}"
      srcset="
        {{ section.settings.image | image_url: width: 600 }} 600w,
        {{ section.settings.image | image_url: width: 900 }} 900w,
        {{ section.settings.image | image_url: width: 1200 }} 1200w,
        {{ section.settings.image | image_url: width: 1800 }} 1800w
      "
      sizes="100vw"
      alt="{{ section.settings.title | escape }}"
      loading="eager"
      fetchpriority="high"
      width="1200"
      height="500"
    >
  {%- endif -%}

  <div class="rl-hero__overlay"></div>

  <div class="rl-hero__content">
    {%- if section.settings.title != blank -%}
      <h1 class="rl-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="rl-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="rl-hero__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Bakgrundsvideo (MP4-länk)",
      "info": "Klistrar in en direktlänk till en MP4-video. Används istället för bilden om den är ifylld."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bakgrundsbild (fallback)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay-styrka (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Rubrik (H1)",
      "default": "Recoverlab - Din väg till optimal återhämtning"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Undertext",
      "default": "Vetenskapligt beprövade recovery-produkter för svenska idrottare"
    },
    {
      "type": "header",
      "content": "Knapp"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Knapptext",
      "default": "Utforska produkter"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Knapplänk"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "title": "Recoverlab - Din väg till optimal återhämtning",
        "subtitle": "Vetenskapligt beprövade recovery-produkter för svenska idrottare",
        "btn_label": "Utforska produkter",
        "overlay_opacity": 50
      }
    }
  ]
}
{% endschema %}
