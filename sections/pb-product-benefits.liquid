<section class="pb-product-benefits">
  <div class="pb-container">
    <div class="pb-product-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="pb-product-benefit pb-fade-in pb-fade-in--d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="pb-product-benefit__icon">{{ block.settings.emoji | default: '✓' }}</div>
          <div class="pb-product-benefit__title">{{ block.settings.title }}</div>
          <div class="pb-product-benefit__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PB — Product Benefits",
  "tag": "section",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji icon", "default": "💪" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{
    "name": "PB — Product Benefits",
    "blocks": [
      { "type": "benefit", "settings": { "emoji": "💪", "title": "Snabbare återhämtning", "text": "Kliniskt bevisad minskning av muskelvärk" } },
      { "type": "benefit", "settings": { "emoji": "😴", "title": "Djupare sömn", "text": "Förbättrar sömnkvalitet med 40%" } },
      { "type": "benefit", "settings": { "emoji": "⚡", "title": "Mer energi", "text": "Naturlig energi utan krascher" } },
      { "type": "benefit", "settings": { "emoji": "🧠", "title": "Mental klarhet", "text": "Skärper fokus och koncentration" } }
    ]
  }]
}
{% endschema %}
