<style>
  .ps-wrap { background: #ffffff; }

  /* Single story block */
  .ps-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 480px;
  }

  /* Odd blocks: image left, text right */
  .ps-block--odd  { direction: ltr; }
  /* Even blocks: image right, text left */
  .ps-block--even { direction: rtl; }
  .ps-block--even > * { direction: ltr; }

  /* Image side */
  .ps-block__media {
    position: relative;
    overflow: hidden;
    min-height: 380px;
  }
  .ps-block__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }
  .ps-block:hover .ps-block__img { transform: scale(1.02); }

  /* Text side */
  .ps-block__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 6vw, 88px) clamp(32px, 5vw, 72px);
    background: #ffffff;
  }
  .ps-block--even .ps-block__body { background: #F7F7F7; }

  .ps-block__label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #2d5a3d;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ps-block__label::before {
    content: '';
    display: block;
    width: 20px;
    height: 2px;
    background: #2d5a3d;
  }

  .ps-block__heading {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(22px, 2.8vw, 34px);
    font-weight: 700;
    color: #000000;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }

  .ps-block__text {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #555555;
    margin: 0 0 24px;
  }
  .ps-block__text p { margin: 0 0 12px; }
  .ps-block__text p:last-child { margin: 0; }
  .ps-block__text ul {
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ps-block__text li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .ps-block__text li::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: #2d5a3d;
    border-radius: 50%;
    margin-top: 7px;
    flex-shrink: 0;
  }

  /* Mobile: stack vertically */
  @media (max-width: 767px) {
    .ps-block {
      grid-template-columns: 1fr;
      direction: ltr !important;
      min-height: auto;
    }
    .ps-block--even > * { direction: ltr; }
    .ps-block__media { min-height: 260px; }
    .ps-block__body { padding: 32px 24px; }
  }
</style>

<div class="ps-wrap">
  {%- for block in section.blocks -%}
    {%- assign is_even = forloop.index | modulo: 2 -%}
    <div
      class="ps-block {% if is_even == 0 %}ps-block--even{% else %}ps-block--odd{% endif %}"
      {{ block.shopify_attributes }}
    >
      <div class="ps-block__media">
        {%- if block.settings.image != blank -%}
          <img
            class="ps-block__img"
            src="{{ block.settings.image | image_url: width: 900 }}"
            srcset="
              {{ block.settings.image | image_url: width: 600 }} 600w,
              {{ block.settings.image | image_url: width: 900 }} 900w,
              {{ block.settings.image | image_url: width: 1200 }} 1200w
            "
            sizes="(max-width: 767px) 100vw, 50vw"
            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            loading="lazy"
            width="900"
            height="600"
          >
        {%- else -%}
          <div style="width:100%;height:100%;background:#f0f0f0;min-height:380px;"></div>
        {%- endif -%}
      </div>

      <div class="ps-block__body">
        {%- if block.settings.label != blank -%}
          <p class="ps-block__label">{{ block.settings.label }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="ps-block__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="ps-block__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Product Story",
  "tag": "section",
  "blocks": [
    {
      "type": "story",
      "name": "Story block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etikett (liten text ovanför rubriken)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Rubrik"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Brödtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Story",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "label": "Fördelar",
            "heading": "Djupgående muskelbehandling",
            "text": "<p>Upplev skillnaden med professionell återhämtningsteknik designad för atleter som tar sin träning på allvar.</p>"
          }
        },
        {
          "type": "story",
          "settings": {
            "label": "Egenskaper",
            "heading": "Teknologi som levererar resultat",
            "text": "<ul><li>Anpassad intensitet för alla muskler</li><li>Lång batteritid för träningspass</li><li>Tyst motor för diskret användning</li></ul>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
