<section class="pb-faq pb-section">
  <div class="pb-container">
    <div class="pb-faq__header">
      <p class="pb-label pb-fade-in">{{ section.settings.label | default: 'FAQ' }}</p>
      <h2 class="pb-heading-lg pb-fade-in pb-fade-in--d1" style="color:var(--pb-text);margin-bottom:16px;">{{ section.settings.title | default: 'Vanliga FrÃ¥gor' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="pb-body-lg pb-fade-in pb-fade-in--d2" style="color:var(--pb-gray-500);">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="pb-faq__list pb-fade-in pb-fade-in--d2">
      {%- for block in section.blocks -%}
        <div class="pb-faq__item" {{ block.shopify_attributes }}>
          <button class="pb-faq__question" type="button" aria-expanded="false">
            {{ block.settings.question }}
            <span class="pb-faq__question-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="pb-faq__answer">
            <div class="pb-faq__answer-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

