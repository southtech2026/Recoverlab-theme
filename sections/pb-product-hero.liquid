<style>
  /* ── Buybox overrides for the reference layout ── */
  .pb-product-buybox__title {
    font-family: 'Montserrat', sans-serif !important;
    font-size: clamp(22px, 3vw, 32px) !important;
    font-weight: 700 !important;
    color: #000000 !important;
    text-transform: none !important;
    letter-spacing: -0.01em !important;
    line-height: 1.2 !important;
    margin-bottom: 10px !important;
  }
  .pb-buybox-price {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #000000;
    margin-bottom: 10px;
  }
  .pb-buybox-price--compare {
    font-size: 15px;
    font-weight: 400;
    color: #aaaaaa;
    text-decoration: line-through;
    margin-left: 8px;
  }

  /* Klarna */
  .pb-buybox-klarna {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #555555;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .pb-buybox-klarna__brand {
    font-weight: 700;
    color: #17120e;
    background: #ffb3c7;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 12px;
    letter-spacing: 0.3px;
  }
  .pb-buybox-klarna a {
    color: #2d5a3d;
    font-weight: 600;
    text-decoration: underline;
  }

  /* Trustpilot row */
  .pb-buybox-trust-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .pb-buybox-tp-stars {
    display: flex;
    gap: 2px;
  }
  .pb-buybox-tp-stars svg {
    width: 18px;
    height: 18px;
    fill: #00b67a;
  }
  .pb-buybox-tp-count {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #2d5a3d;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(45,90,61,0.3);
  }
  .pb-buybox-tp-count:hover { border-color: #2d5a3d; }

  /* Feature checkmarks */
  .pb-buybox-features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .pb-buybox-features li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #2d5a3d;
    font-weight: 500;
  }
  .pb-buybox-features li svg {
    width: 15px;
    height: 15px;
    color: #2d5a3d;
    flex-shrink: 0;
  }

  /* Divider */
  .pb-buybox-divider {
    height: 1px;
    background: #e5e5e5;
    margin: 16px 0;
  }

  /* Quantity + ATC row */
  .pb-buybox-atc-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    margin-bottom: 12px;
  }
  .pb-buybox-qty {
    display: flex;
    align-items: center;
    border: 1.5px solid #e5e5e5;
    background: #fff;
    flex-shrink: 0;
  }
  .pb-buybox-qty__btn {
    width: 40px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    color: #000;
    transition: background 150ms ease;
    line-height: 1;
  }
  .pb-buybox-qty__btn:hover { background: #f7f7f7; }
  .pb-buybox-qty__val {
    width: 40px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    border: none;
    background: none;
    color: #000;
    -moz-appearance: textfield;
  }
  .pb-buybox-qty__val::-webkit-inner-spin-button,
  .pb-buybox-qty__val::-webkit-outer-spin-button { -webkit-appearance: none; }

  .pb-buybox-atc-btn {
    flex: 1;
    background: #2d5a3d;
    color: #ffffff;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .pb-buybox-atc-btn:hover:not(:disabled) {
    background: #1e3d2a;
    transform: translateY(-1px);
  }
  .pb-buybox-atc-btn:disabled {
    background: #aaaaaa;
    cursor: not-allowed;
  }

  /* Trust badges below ATC */
  .pb-buybox-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 12px;
    background: #ffffff !important;
    background-color: #ffffff !important;
    padding: 14px 0;
    border-top: 1px solid #e5e5e5;
  }
  .pb-buybox-badge,
  .pb-buybox-badge * {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inter', sans-serif !important;
    font-size: 13px !important;
    color: #2d5a3d !important;
    font-weight: 700 !important;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    background: transparent !important;
  }
  .pb-buybox-badge svg {
    width: 15px !important;
    height: 15px !important;
    color: #2d5a3d !important;
    fill: none !important;
    flex-shrink: 0;
  }

  /* Delivery bar */
  .pb-buybox-delivery {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #f7f7f7;
    border-left: 3px solid #2d5a3d;
    padding: 11px 14px;
    margin-top: 14px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #555555;
  }
  .pb-buybox-delivery svg {
    width: 16px;
    height: 16px;
    color: #2d5a3d;
    flex-shrink: 0;
  }

  /* Bundle picker */
  .pb-bundle__title { font-family: 'Montserrat', sans-serif; font-size: 15px; font-weight: 700; color: #000; margin-bottom: 12px; letter-spacing: -0.01em; }
  .pb-bundle__options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
  .pb-bundle__option { display: flex; align-items: center; gap: 14px; border: 1.5px solid #e5e5e5; padding: 14px 16px; cursor: pointer; transition: border-color 200ms ease, background 200ms ease; background: #fff; position: relative; }
  .pb-bundle__option:hover { border-color: #2d5a3d; }
  .pb-bundle__option.is-selected { border-color: #2d5a3d; background: #f4f8f5; }
  .pb-bundle__badge { position: absolute; top: -10px; left: 16px; background: #2d5a3d; color: #fff; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 2px 8px; }
  .pb-bundle__radio { width: 18px; height: 18px; border: 1.5px solid #ccc; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .pb-bundle__option.is-selected .pb-bundle__radio { border-color: #2d5a3d; }
  .pb-bundle__radio-dot { width: 9px; height: 9px; border-radius: 50%; background: transparent; transition: background 200ms ease; }
  .pb-bundle__option.is-selected .pb-bundle__radio-dot { background: #2d5a3d; }
  .pb-bundle__option-info { flex: 1; }
  .pb-bundle__option-qty { font-size: 14px; font-weight: 700; color: #000; }
  .pb-bundle__option-label { font-size: 12px; color: #555; margin-top: 1px; }
  .pb-bundle__option-price { text-align: right; flex-shrink: 0; }
  .pb-bundle__option-price-main { font-size: 15px; font-weight: 700; color: #000; }
  .pb-bundle__option-price-save { font-size: 12px; color: #2d5a3d; font-weight: 600; margin-top: 1px; }
  .pb-bundle__option-price-each { font-size: 11px; color: #aaa; margin-top: 1px; }

  #pb-bundle-variant-selectors select:focus {
    outline: none;
    border-color: #2d5a3d;
  }

  /* Sticky ATC bar — alla enheter */
  #pb-sticky-atc-bar {
    display: block !important;
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 9999 !important;
    background: #ffffff !important;
    border-top: 1px solid #e5e5e5 !important;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.10) !important;
    transform: translateY(110%) !important;
    transition: transform 300ms ease !important;
    will-change: transform;
    padding: 0 !important;
  }
  #pb-sticky-atc-bar.is-visible {
    transform: translateY(0) !important;
  }
  #pb-sticky-atc-bar .pb-sticky-atc__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  #pb-sticky-atc-bar .pb-sticky-atc__info {
    flex: 1;
    min-width: 0;
  }
  #pb-sticky-atc-bar .pb-sticky-atc__title {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #pb-sticky-atc-bar .pb-sticky-atc__price {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #555;
    margin-top: 2px;
  }
  #pb-sticky-atc-bar .pb-sticky-atc__btn {
    background: #2d5a3d;
    color: #fff;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    padding: 13px 28px;
    white-space: nowrap;
    transition: background 200ms ease;
    flex-shrink: 0;
  }
  #pb-sticky-atc-bar .pb-sticky-atc__btn:hover {
    background: #1e3d2a;
  }
  @media (max-width: 767px) {
    #pb-sticky-atc-bar .pb-sticky-atc__inner { padding: 10px 14px; gap: 10px; }
    #pb-sticky-atc-bar .pb-sticky-atc__title { font-size: 12px; }
    #pb-sticky-atc-bar .pb-sticky-atc__btn { padding: 12px 18px; font-size: 12px; }
  }

  .pb-bundle__discount-note {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #2d5a3d;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .pb-bundle__discount-note svg {
    flex-shrink: 0;
    color: #2d5a3d;
  }
</style>

<section class="pb-product-hero">
  <div class="pb-container">
    <div class="pb-product-hero__grid">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="pb-product-gallery">
        <div class="pb-product-gallery__main" id="pb-main-image">
          {%- if product.featured_image != blank -%}
            <img
              id="pb-gallery-main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="eager"
              width="900"
              height="900"
            >
          {%- else -%}
            <div style="background:#f7f7f7;width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
              <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#cccccc" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="pb-product-gallery__thumbs pb-gallery-thumbs-scroll">
            {%- for image in product.images -%}
              <div
                class="pb-product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ image | image_url: width: 900 }}"
                data-alt="{{ image.alt | default: product.title | escape }}"
                role="button"
                tabindex="0"
                aria-label="Visa bild {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buybox {%- endcomment -%}
      <div class="pb-product-buybox">

        {%- if product.type != blank -%}
          <div class="pb-product-buybox__category">{{ product.type }}</div>
        {%- endif -%}

        <h1 class="pb-product-buybox__title">{{ product.title }}</h1>

        {%- comment -%} Price {%- endcomment -%}
        <div class="pb-buybox-price">
          {{ product.price | money }}
          {%- if product.compare_at_price > product.price -%}
            <span class="pb-buybox-price--compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Klarna {%- endcomment -%}
        {%- if section.settings.show_klarna -%}
          <div class="pb-buybox-klarna">
            Shoppa nu. Betala inom 60 dagar med
            <span class="pb-buybox-klarna__brand">Klarna</span>
            <a href="https://www.klarna.com/se/" target="_blank" rel="noopener">Läs mer</a>
          </div>
        {%- endif -%}

        {%- comment -%} Feature checkmarks {%- endcomment -%}
        {%- assign feature_blocks = section.blocks | where: "type", "feature" -%}
        {%- if feature_blocks.size > 0 -%}
          <ul class="pb-buybox-features">
            {%- for block in feature_blocks -%}
              <li {{ block.shopify_attributes }}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {{ block.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} Variants {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="pb-buybox-divider"></div>
          {%- for option in product.options_with_values -%}
            <div class="pb-product-buybox__label">{{ option.name }}</div>
            <div class="pb-product-variants" style="margin-bottom:12px;">
              {%- for value in option.values -%}
                {%- comment -%} Find first variant matching this option value {%- endcomment -%}
                {%- assign matched_variant = nil -%}
                {%- for variant in product.variants -%}
                  {%- if option.position == 1 and variant.option1 == value -%}
                    {%- assign matched_variant = variant -%}
                    {%- break -%}
                  {%- elsif option.position == 2 and variant.option2 == value -%}
                    {%- assign matched_variant = variant -%}
                    {%- break -%}
                  {%- elsif option.position == 3 and variant.option3 == value -%}
                    {%- assign matched_variant = variant -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                <button
                  type="button"
                  class="pb-product-variant{% if forloop.first %} is-active{% endif %}"
                  data-variant-id="{{ matched_variant.id }}"
                  {%- if matched_variant.featured_image != blank -%}
                    data-image="{{ matched_variant.featured_image | image_url: width: 900 }}"
                    data-image-srcset="{{ matched_variant.featured_image | image_url: width: 400 }} 400w, {{ matched_variant.featured_image | image_url: width: 900 }} 900w"
                    data-image-alt="{{ matched_variant.featured_image.alt | escape }}"
                  {%- elsif product.featured_image != blank -%}
                    data-image="{{ product.featured_image | image_url: width: 900 }}"
                    data-image-alt="{{ product.featured_image.alt | escape }}"
                  {%- endif -%}
                >{{ value }}</button>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pb-buybox-divider"></div>

        {%- liquid
          assign bundle_meta = product.metafields.custom.bundle_options
          assign base_price  = product.selected_or_first_available_variant.price
        -%}

        {%- if bundle_meta != blank -%}
          {%- assign bundle_items = bundle_meta.value -%}
          <div class="pb-bundle__title">{{ section.settings.bundle_title | default: 'Välj ditt paket' }}</div>
          <div class="pb-bundle__options" id="pb-bundle-options">
            {%- for item in bundle_items -%}
              {%- assign total_price  = base_price | times: item.qty -%}
              {%- assign discount_pct = item.discount | plus: 0 -%}
              {%- assign save_amount  = total_price | times: discount_pct | divided_by: 100 -%}
              {%- assign final_price  = total_price | minus: save_amount -%}
              {%- assign price_each   = final_price | divided_by: item.qty -%}
              <div
                class="pb-bundle__option{% if forloop.first %} is-selected{% endif %}"
                data-qty="{{ item.qty }}"
                role="radio"
                aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="0"
                style="flex-wrap:wrap;"
              >
                {%- if item.badge != blank -%}
                  <span class="pb-bundle__badge">{{ item.badge }}</span>
                {%- endif -%}
                <div class="pb-bundle__radio"><div class="pb-bundle__radio-dot"></div></div>
                <div class="pb-bundle__option-info">
                  <div class="pb-bundle__option-qty">{{ item.qty }} st</div>
                  {%- if item.label != blank -%}<div class="pb-bundle__option-label">{{ item.label }}</div>{%- endif -%}
                </div>
                <div class="pb-bundle__option-price">
                  <div class="pb-bundle__option-price-main">{{ final_price | money }}</div>
                  {%- if discount_pct > 0 -%}<div class="pb-bundle__option-price-save">Spara {{ save_amount | money }}</div>{%- endif -%}
                  <div class="pb-bundle__option-price-each">{{ price_each | money }} / st</div>
                </div>
                <div class="pb-bundle__selectors" style="display:none; width:100%; margin-top:12px; padding-top:12px; border-top:1px solid #e5e5e5; flex-direction:column; gap:8px;"></div>
              </div>
            {%- endfor -%}
          </div>

          <div class="pb-bundle__discount-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Rabatten appliceras automatiskt i kassan
          </div>

          <div class="pb-buybox-atc-row" id="pb-main-atc-row">
            <button type="button" id="pb-bundle-atc-btn" class="pb-buybox-atc-btn" {% unless product.available %}disabled{% endunless %}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span id="pb-bundle-atc-label">{% if product.available %}Köp nu{% else %}Slut i lager{% endif %}</span>
            </button>
          </div>

          {%- assign variants_json = product.variants | json -%}
          <script>
            window.pbProductVariants = {{ variants_json }};
            window.pbProductOptions  = {{ product.options_with_values | json }};
          </script>

        {%- else -%}

          {%- form 'product', product -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <div class="pb-buybox-atc-row" id="pb-main-atc-row">
              <div class="pb-buybox-qty">
                <button type="button" class="pb-buybox-qty__btn" data-action="decrease" aria-label="Minska antal">−</button>
                <input type="number" name="quantity" class="pb-buybox-qty__val" value="1" min="1" aria-label="Antal">
                <button type="button" class="pb-buybox-qty__btn" data-action="increase" aria-label="Öka antal">+</button>
              </div>
              <button type="submit" class="pb-buybox-atc-btn" {% unless product.available %}disabled{% endunless %}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                {% if product.available %}Köp nu{% else %}Slut i lager{% endif %}
              </button>
            </div>
          {%- endform -%}

        {%- endif -%}

        {%- comment -%} Trust badges {%- endcomment -%}
        <div class="pb-buybox-badges">
          <div class="pb-buybox-badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Säker betalning
          </div>
          <div class="pb-buybox-badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {{ section.settings.return_text | default: '30 dagars returrätt' }}
          </div>
          <div class="pb-buybox-badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Fri frakt 499 kr+
          </div>
          <div class="pb-buybox-badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Svensk support
          </div>
        </div>


      </div>
    </div>
  </div>

  {%- comment -%} Sticky ATC — visas när main ATC scrollas förbi {%- endcomment -%}
  <div class="pb-sticky-atc" id="pb-sticky-atc-bar" aria-hidden="true">
    <div class="pb-sticky-atc__inner">
      <div class="pb-sticky-atc__info">
        <div class="pb-sticky-atc__title">{{ product.title }}</div>
        <div class="pb-sticky-atc__price">{{ product.price | money }}</div>
      </div>
      <button type="button" class="pb-sticky-atc__btn" id="pb-sticky-atc-btn">Köp nu</button>
    </div>
  </div>
</section>

<script>
(function () {
  /* ── Quantity stepper ── */
  document.querySelectorAll('.pb-buybox-qty__btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.closest('.pb-buybox-qty').querySelector('.pb-buybox-qty__val');
      var val = parseInt(input.value, 10) || 1;
      input.value = btn.dataset.action === 'increase' ? val + 1 : Math.max(1, val - 1);
    });
  });

  /* ── Thumbnail gallery — all images ── */
  var mainImg = document.getElementById('pb-gallery-main-img');

  function swapMainImage(src, alt) {
    if (!mainImg) return;
    mainImg.style.opacity = '0';
    mainImg.style.transition = 'opacity 0.18s ease';
    setTimeout(function () {
      mainImg.src = src;
      if (alt) mainImg.alt = alt;
      mainImg.style.opacity = '1';
    }, 140);
  }

  document.querySelectorAll('.pb-product-gallery__thumb').forEach(function (thumb) {
    function activate() {
      document.querySelectorAll('.pb-product-gallery__thumb').forEach(function (t) {
        t.classList.remove('is-active');
      });
      thumb.classList.add('is-active');
      if (thumb.dataset.src) swapMainImage(thumb.dataset.src, thumb.dataset.alt);
    }
    thumb.addEventListener('click', activate);
    thumb.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
    });
  });

  /* ── Variant switcher — image + form ID ── */
  var formInput  = document.querySelector('.pb-product-hero input[name="id"]');
  var priceEl    = document.querySelector('.pb-buybox-price');
  var stickyPrice = document.querySelector('.pb-sticky-atc__price');

  document.querySelectorAll('.pb-product-variant').forEach(function (btn) {
    btn.addEventListener('click', function () {

      /* Active state — only within same option group */
      btn.closest('.pb-product-variants')
         .querySelectorAll('.pb-product-variant')
         .forEach(function (s) { s.classList.remove('is-active'); });
      btn.classList.add('is-active');

      /* Swap main gallery image */
      if (btn.dataset.image && mainImg) {
        mainImg.style.opacity = '0';
        mainImg.style.transition = 'opacity 0.2s ease';
        setTimeout(function () {
          mainImg.src = btn.dataset.image;
          if (btn.dataset.imageSrcset) mainImg.srcset = btn.dataset.imageSrcset;
          if (btn.dataset.imageAlt)    mainImg.alt    = btn.dataset.imageAlt;
          mainImg.style.opacity = '1';
        }, 150);
      }

      /* Update hidden variant ID for add-to-cart form */
      if (btn.dataset.variantId && formInput) {
        formInput.value = btn.dataset.variantId;
      }

      /* Fetch variant price and update display */
      if (btn.dataset.variantId) {
        fetch('/variants/' + btn.dataset.variantId + '.js')
          .then(function (r) { return r.json(); })
          .then(function (v) {
            var formatted = (v.price / 100).toFixed(2).replace('.', ',') + ' kr';
            if (priceEl)    priceEl.firstChild.textContent = formatted;
            if (stickyPrice) stickyPrice.textContent = formatted;
          })
          .catch(function () {});
      }
    });
  });

  /* ── Bundle variant selectors + Cart API ── */
  var bundleOptions  = document.querySelectorAll('#pb-bundle-options .pb-bundle__option');
  var bundleAtcBtn   = document.getElementById('pb-bundle-atc-btn');
  var bundleAtcLabel = document.getElementById('pb-bundle-atc-label');
  var baseBtnLabel   = bundleAtcLabel ? bundleAtcLabel.textContent.trim() : 'Köp nu';

  var pbVariants = window.pbProductVariants || [];
  var pbOptions  = window.pbProductOptions  || [];

  function findVariantBySelections(selections) {
    return pbVariants.find(function (v) {
      return selections.every(function (sel, i) {
        return v['option' + (i + 1)] === sel;
      });
    });
  }

  function buildSelectors(selectedEl) {
    document.querySelectorAll('.pb-bundle__selectors').forEach(function (s) {
      s.style.display = 'none';
      s.innerHTML = '';
    });

    if (!selectedEl) return;
    var qty = parseInt(selectedEl.dataset.qty, 10) || 1;
    if (qty <= 1 || pbOptions.length === 0) return;

    var wrap = selectedEl.querySelector('.pb-bundle__selectors');
    if (!wrap) return;
    wrap.style.display = 'flex';

    /* Get pre-selected values from active variant */
    var activeBtn = document.querySelector('.pb-product-variant.is-active');
    var activeVariant = activeBtn
      ? pbVariants.find(function (v) { return String(v.id) === String(activeBtn.dataset.variantId); })
      : null;

    for (var i = 0; i < qty; i++) {
      var item = document.createElement('div');
      item.style.cssText = 'display:flex; align-items:flex-start; gap:10px; flex-wrap:wrap;';

      var lbl = document.createElement('div');
      lbl.style.cssText = 'font-family:Inter,sans-serif; font-size:12px; font-weight:600; color:#555; text-transform:uppercase; letter-spacing:0.5px; white-space:nowrap; min-width:70px; padding-top:6px;';
      lbl.textContent = 'Exemplar ' + (i + 1);
      item.appendChild(lbl);

      var row = document.createElement('div');
      row.style.cssText = 'display:flex; flex-wrap:wrap; gap:6px; flex:1;';

      pbOptions.forEach(function (opt) {
        var optGroup = document.createElement('div');
        optGroup.style.cssText = 'display:flex; flex-wrap:wrap; gap:6px;';

        var preselectedVal = null;
        if (activeVariant) {
          var optIndex = pbOptions.findIndex(function (o) { return o.name === opt.name; });
          if (optIndex > -1) preselectedVal = activeVariant['option' + (optIndex + 1)];
        }
        if (!preselectedVal) preselectedVal = opt.values[0];

        opt.values.forEach(function (val) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.exemplar = i;
          btn.dataset.option   = opt.name;
          btn.dataset.val      = val;
          btn.textContent      = val;
          var isActive = val === preselectedVal;
          btn.className = 'pb-bundle-val-btn' + (isActive ? ' is-active' : '');
          btn.style.cssText = 'height:34px; padding:0 12px; border:1.5px solid ' + (isActive ? '#2d5a3d' : '#e5e5e5') + '; background:' + (isActive ? '#f4f8f5' : '#fff') + '; font-family:Inter,sans-serif; font-size:12px; font-weight:' + (isActive ? '700' : '500') + '; color:#000; cursor:pointer; white-space:nowrap; transition:border-color 150ms,background 150ms;';

          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            /* Deactivate siblings in same option group */
            optGroup.querySelectorAll('.pb-bundle-val-btn').forEach(function (b) {
              b.classList.remove('is-active');
              b.style.borderColor = '#e5e5e5';
              b.style.background  = '#fff';
              b.style.fontWeight  = '500';
            });
            btn.classList.add('is-active');
            btn.style.borderColor = '#2d5a3d';
            btn.style.background  = '#f4f8f5';
            btn.style.fontWeight  = '700';
          });

          optGroup.appendChild(btn);
        });

        row.appendChild(optGroup);
      });

      item.appendChild(row);
      wrap.appendChild(item);
    }
  }

  function getSelectedQty() {
    var selected = document.querySelector('#pb-bundle-options .pb-bundle__option.is-selected');
    return selected ? (parseInt(selected.dataset.qty, 10) || 1) : 1;
  }

  /* Select bundle option */
  bundleOptions.forEach(function (el) {
    function selectBundle() {
      bundleOptions.forEach(function (o) {
        o.classList.remove('is-selected');
        o.setAttribute('aria-checked', 'false');
      });
      el.classList.add('is-selected');
      el.setAttribute('aria-checked', 'true');

      var qty = parseInt(el.dataset.qty, 10) || 1;
      buildSelectors(el);

      if (bundleAtcLabel) {
        bundleAtcLabel.textContent = qty > 1
          ? baseBtnLabel + ' (' + qty + ' st)'
          : baseBtnLabel;
      }
    }
    el.addEventListener('click', selectBundle);
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectBundle(); }
    });
  });

  /* ATC via Cart API */
  if (bundleAtcBtn) {
    bundleAtcBtn.addEventListener('click', function () {
      var qty = getSelectedQty();

      var bundleDiscountCodes = { 1: 'Bundel 1', 2: 'Bundel 2', 3: 'Bundel 3' };

      /* Single item – add to cart first, then apply discount, then redirect */
      if (qty <= 1 || pbOptions.length === 0) {
        /* No variants: use standard form submit */
        if (pbOptions.length === 0) {
          var existingForm = document.querySelector('.pb-product-hero form');
          if (existingForm) { existingForm.submit(); }
          return;
        }

        /* Has variants: find selected variant from active button */
        var activeVariantBtn = document.querySelector('.pb-product-variant.is-active');
        var singleVariantId  = activeVariantBtn
          ? activeVariantBtn.dataset.variantId
          : (pbVariants.length > 0 ? String(pbVariants[0].id) : null);

        if (!singleVariantId) return;

        bundleAtcBtn.disabled = true;
        if (bundleAtcLabel) bundleAtcLabel.textContent = 'Lägger till…';

        fetch('/cart/add.js', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ items: [{ id: parseInt(singleVariantId, 10), quantity: 1 }] })
        })
        .then(function (r) { return r.json(); })
        .then(function () {
          var singleCode = bundleDiscountCodes[1];
          if (singleCode) {
            return fetch('/discount/' + encodeURIComponent(singleCode), {
              method: 'GET',
              headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
          }
        })
        .then(function () {
          window.location.href = '/cart';
        })
        .catch(function () {
          bundleAtcBtn.disabled = false;
          if (bundleAtcLabel) bundleAtcLabel.textContent = baseBtnLabel;
          alert('Något gick fel, försök igen.');
        });
        return;
      }

      /* Build items array – one per exemplar */
      var selectedOption = document.querySelector('#pb-bundle-options .pb-bundle__option.is-selected');
      var activeBtns = selectedOption ? selectedOption.querySelectorAll('.pb-bundle-val-btn.is-active') : [];
      var exemplarMap = {};

      activeBtns.forEach(function (btn) {
        var idx = btn.dataset.exemplar;
        if (!exemplarMap[idx]) exemplarMap[idx] = [];
        exemplarMap[idx].push(btn.dataset.val);
      });

      var items = [];
      Object.keys(exemplarMap).forEach(function (idx) {
        var selections = exemplarMap[idx];
        var variant    = findVariantBySelections(selections);
        if (variant) {
          items.push({ id: variant.id, quantity: 1 });
        }
      });

      if (items.length === 0) return;

      bundleAtcBtn.disabled = true;
      if (bundleAtcLabel) bundleAtcLabel.textContent = 'Lägger till…';

      fetch('/cart/add.js', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ items: items })
      })
      .then(function (r) { return r.json(); })
      .then(function () {
        var discountCode = bundleDiscountCodes[qty];
        if (discountCode) {
          return fetch('/discount/' + encodeURIComponent(discountCode), {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });
        }
      })
      .then(function () {
        window.location.href = '/cart';
      })
      .catch(function () {
        bundleAtcBtn.disabled = false;
        if (bundleAtcLabel) bundleAtcLabel.textContent = baseBtnLabel;
        alert('Något gick fel, försök igen.');
      });
    });
  }

  /* Init selectors for default selected bundle option */
  buildSelectors(document.querySelector('#pb-bundle-options .pb-bundle__option.is-selected'));

  /* ── Sticky ATC — visa när main ATC scrollas förbi ── */
  var stickyBar = document.getElementById('pb-sticky-atc-bar');
  var stickyBtn = document.getElementById('pb-sticky-atc-btn');
  var atcAnchor = document.getElementById('pb-main-atc-row');

  if (stickyBar && atcAnchor && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          stickyBar.classList.remove('is-visible');
          stickyBar.setAttribute('aria-hidden', 'true');
        } else {
          stickyBar.classList.add('is-visible');
          stickyBar.setAttribute('aria-hidden', 'false');
        }
      });
    }, { threshold: 0 });
    observer.observe(atcAnchor);
  }

  if (stickyBtn) {
    stickyBtn.addEventListener('click', function () {
      /* Bundle mode */
      var bundleBtn = document.getElementById('pb-bundle-atc-btn');
      if (bundleBtn) { bundleBtn.click(); return; }
      /* Standard form mode */
      var form = document.querySelector('.pb-product-hero form');
      if (form) { form.submit(); }
    });
  }
})();
</script>

<script src="{{ 'premium-brand.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PB — Product Hero",
  "tag": "section",
  "settings": [
    { "type": "header",   "content": "Recensioner" },
    { "type": "number",   "id": "review_count_num", "label": "Antal omdömen", "default": 70 },
    { "type": "header",   "content": "Klarna" },
    { "type": "checkbox", "id": "show_klarna",   "label": "Visa Klarna-meddelande", "default": true },
    { "type": "header",   "content": "Knappar & text" },
    { "type": "text",     "id": "atc_label",     "label": "Lägg i kundvagn-text", "default": "Köp nu" },
    { "type": "text",     "id": "return_text",   "label": "Returtext",         "default": "30 dagars returrätt" },
    { "type": "text",     "id": "delivery_text", "label": "Leveranstext",      "default": "Leveranstid 5–12 arbetsdagar." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Produktfördel",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Fördel",
          "default": "Skriv en produktfördel här"
        }
      ]
    }
  ],
  "presets": [{
    "name": "PB — Product Hero",
    "blocks": [
      { "type": "feature", "settings": { "text": "Värme- & kylfunktion" } },
      { "type": "feature", "settings": { "text": "Tre timmars batteritid" } },
      { "type": "feature", "settings": { "text": "5 olika munstycken" } },
      { "type": "feature", "settings": { "text": "Upp till 3000 RPM" } }
    ]
  }]
}
{% endschema %}
