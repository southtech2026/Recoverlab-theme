{{ 'premium-brand.css' | asset_url | stylesheet_tag }}

<section class="pb-product-hero">
  <div class="pb-container">
    <div class="pb-product-hero__grid">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="pb-product-gallery">
        <div class="pb-product-gallery__main" id="pb-main-image">
          {%- if product.featured_image != blank -%}
            <img
              id="pb-gallery-main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="eager"
              width="900"
              height="900"
            >
          {%- else -%}
            <div style="background:var(--pb-cream);width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
              <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="var(--pb-gray-300)" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="pb-product-gallery__thumbs">
            {%- for image in product.images limit: 4 -%}
              <div
                class="pb-product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ image | image_url: width: 900 }}"
              >
                <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buybox {%- endcomment -%}
      <div class="pb-product-buybox">
        <div class="pb-product-buybox__category">{{ product.type | default: section.settings.category }}</div>
        <h1 class="pb-product-buybox__title">{{ product.title }}</h1>
        <div class="pb-product-buybox__reviews">
          <div class="pb-stars">{% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}</div>
          <a href="#pb-product-reviews" class="pb-product-buybox__review-count">{{ section.settings.review_text | default: '(156 recensioner)' }}</a>
        </div>
        <div class="pb-product-buybox__price">{{ product.price | money }}</div>
        <div class="pb-product-buybox__price-note">{{ section.settings.price_note | default: 'Inkl. moms. Fri frakt över 499 kr.' }}</div>

        {%- unless product.has_only_default_variant -%}
          <div class="pb-product-buybox__divider"></div>
          {%- for option in product.options_with_values -%}
            <div class="pb-product-buybox__label">{{ option.name }}</div>
            <div class="pb-product-variants">
              {%- for value in option.values -%}
                <button type="button" class="pb-product-variant{% if forloop.first %} is-active{% endif %}">{{ value }}</button>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pb-product-buybox__divider"></div>
        <div class="pb-product-buybox__label">Antal</div>
        <div class="pb-product-quantity">
          <button type="button" class="pb-product-quantity__btn" data-action="decrease">−</button>
          <input type="number" class="pb-product-quantity__value" value="1" min="1" readonly>
          <button type="button" class="pb-product-quantity__btn" data-action="increase">+</button>
        </div>

        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="pb-add-to-cart" {% unless product.available %}disabled{% endunless %}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {% if product.available %}{{ section.settings.atc_label | default: 'Lägg i kundvagn' }}{% else %}Slut i lager{% endif %}
          </button>
        {%- endform -%}

        <a href="/checkout" class="pb-buy-now">{{ section.settings.buy_now_label | default: 'Köp direkt' }}</a>

        <div class="pb-product-trust">
          <div class="pb-product-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Säker betalning
          </div>
          <div class="pb-product-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            30 dagars garanti
          </div>
          <div class="pb-product-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Fri frakt 499 kr+
          </div>
          <div class="pb-product-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Svensk support
          </div>
        </div>

        <div class="pb-product-delivery">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>{{ section.settings.delivery_text | default: 'Beställ innan kl 15.00 – levereras inom 1–3 vardagar.' }}</span>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Sticky Add to Cart (mobile) {%- endcomment -%}
  <div class="pb-sticky-atc">
    <div class="pb-sticky-atc__inner">
      <div class="pb-sticky-atc__info">
        <div class="pb-sticky-atc__title">{{ product.title }}</div>
        <div class="pb-sticky-atc__price">{{ product.price | money }}</div>
      </div>
      <button type="button" class="pb-sticky-atc__btn">{{ section.settings.atc_label | default: 'Lägg i kundvagn' }}</button>
    </div>
  </div>
</section>

<script src="{{ 'premium-brand.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PB — Product Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "category", "label": "Category label", "default": "Återhämtning" },
    { "type": "text", "id": "review_text", "label": "Review count text", "default": "(156 recensioner)" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Inkl. moms. Fri frakt över 499 kr." },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Lägg i kundvagn" },
    { "type": "text", "id": "buy_now_label", "label": "Buy now label", "default": "Köp direkt" },
    { "type": "text", "id": "delivery_text", "label": "Delivery text", "default": "Beställ innan kl 15.00 – levereras inom 1–3 vardagar." }
  ],
  "presets": [{ "name": "PB — Product Hero" }]
}
{% endschema %}
