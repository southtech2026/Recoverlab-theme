<style>
  .pb-why-us__cta {
    text-align: center;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  .pb-why-us__cta-btn {
    display: inline-block;
    background: #FFFFFF;
    color: #000000;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 36px;
    border: 2px solid #FFFFFF;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .pb-why-us__cta-btn:hover {
    background: transparent;
    color: #FFFFFF;
  }
</style>
﻿<section class="pb-why-us pb-section">
  <div class="pb-container">
    <div class="pb-why-us__header">
      <p class="pb-label pb-fade-in">{{ section.settings.label | default: 'VarfÃ¶r oss' }}</p>
      <h2 class="pb-heading-lg pb-fade-in pb-fade-in--d1" style="color:var(--pb-text);margin-bottom:16px;">{{ section.settings.title | default: 'VarfÃ¶r VÃ¤lja Oss?' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="pb-body-lg pb-fade-in pb-fade-in--d2" style="color:var(--pb-gray-500);">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="pb-why-us__grid">
      {%- for block in section.blocks -%}
        <div class="pb-why-us__item pb-fade-in pb-fade-in--d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="pb-why-us__item-icon">
            {%- if block.settings.icon == 'science' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v11l6 3 6-3V9M9 14l6 3 6-3"/></svg>
            {%- elsif block.settings.icon == 'quality' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- elsif block.settings.icon == 'shipping' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {%- elsif block.settings.icon == 'payment' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            {%- elsif block.settings.icon == 'support' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            {%- endif -%}
          </div>
          <div class="pb-why-us__item-title">{{ block.settings.title }}</div>
          <div class="pb-why-us__item-text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- assign _cta_label = section.settings.cta_label | default: 'Läs mer om oss' -%}
    {%- assign _cta_url   = section.settings.cta_url   | default: '/pages/om-oss' -%}
    <div class="pb-why-us__cta">
      <a href="{{ _cta_url }}" class="pb-why-us__cta-btn">{{ _cta_label }}</a>
    </div>
  </div>
</section>

