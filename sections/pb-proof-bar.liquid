<section class="pb-proof-bar">
  <div class="pb-container">
    <div class="pb-proof-bar__inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="pb-proof-bar__item pb-fade-in" {{ block.shopify_attributes }}>
            <div class="pb-proof-bar__number">
              {%- if block.settings.number != blank -%}
                <span class="pb-counter" data-target="{{ block.settings.number }}" data-suffix="{{ block.settings.suffix }}">{{ block.settings.number }}{{ block.settings.suffix }}</span>
              {%- endif -%}
            </div>
            <div class="pb-proof-bar__label">{{ block.settings.label }}</div>
          </div>
          {%- unless forloop.last -%}<div class="pb-proof-bar__divider"></div>{%- endunless -%}
        {%- elsif block.type == 'rating' -%}
          <div class="pb-proof-bar__item pb-fade-in" {{ block.shopify_attributes }}>
            <div class="pb-proof-bar__number">
              {%- if block.settings.rating != blank -%}
                <span class="pb-counter" data-target="{{ block.settings.rating }}" data-suffix="/5">{{ block.settings.rating }}/5</span>
              {%- endif -%}
            </div>
            <div class="pb-stars" style="justify-content:center;margin-bottom:4px;">
              {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}
            </div>
            <div class="pb-proof-bar__label">{{ block.settings.label }}</div>
          </div>
          {%- unless forloop.last -%}<div class="pb-proof-bar__divider"></div>{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PB — Proof Bar",
  "tag": "section",
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "50000" },
        { "type": "text", "id": "suffix", "label": "Suffix (e.g. +, %)", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Nöjda kunder" }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "settings": [
        { "type": "text", "id": "rating", "label": "Rating (e.g. 4.9)", "default": "4.9" },
        { "type": "text", "id": "label", "label": "Label", "default": "Genomsnittligt betyg" }
      ]
    }
  ],
  "presets": [{
    "name": "PB — Proof Bar",
    "blocks": [
      { "type": "stat", "settings": { "number": "50000", "suffix": "+", "label": "Nöjda kunder" } },
      { "type": "rating", "settings": { "rating": "4.9", "label": "Genomsnittligt betyg" } },
      { "type": "stat", "settings": { "number": "98", "suffix": "%", "label": "Rekommenderar oss" } },
      { "type": "stat", "settings": { "number": "3", "suffix": " år", "label": "Erfarenhet" } }
    ]
  }]
}
{% endschema %}
