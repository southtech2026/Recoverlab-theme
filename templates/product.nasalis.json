        "pf2": {
          "type": "item",
          "settings": {
            "question": "Kan jag använda dem under träning?",
            "answer": "<p>Ja. Nasalis fungerar lika bra vid fysisk aktivitet som under sömn. Många använder dem vid löpning eller andra pass där man vill hålla näsandningen igång.</p>"
          }
        },
        "pf3": {
          "type": "item",
          "settings": {
            "question": "Går de att använda om jag har känslig hud?",
            "answer": "<p>Materialet är hypoallergent och framtaget för att vara skonsamt mot huden. Ta av plåstret försiktigt genom att lossa det från kanterna. Om du får hudirritation, sluta använda produkten.</p>"
          }
        },
        "pf4": {
          "type": "item",
          "settings": {
            "question": "Hur många remsor ingår i en förpackning?",
